attr[seg000:0296]: targets = segvga:0118
attr[seg000:02c1]: type = code
attr[seg000:02de]: type = code; name = intro2_scene_stars; comment = [[[
    script_2[0] (si=1): plain starfield scene. xor cx,cx; jmp draw_stars -> the unscrolled starfield at count=0 with the moons composited on top.
    Dispatched by loc_002c1 via cs:[si*2 + 0x20a] when intro2 plays scene 1.
]]]
attr[seg000:02e0]: type = code; name = draw_stars
attr[seg000:02e3]: type = code; name = intro2_scene_globe; comment = [[[
    script_2[1] (si=2) and script_2[5] (si=6): the rotating globe over a parallax-scrolled starfield.
    mov cx,0x20; call draw_stars (the count=0x20 parallax-pan variant).
    setup_globe_draw; draw_globe_with_atmosphere (the globe with its atmosphere shell).
    ax=0x2c; open_resource_by_index -> STARS.HSQ (re-applies the embedded palette so the following 0x3a transition fades to it).
    jmp loc_0b8ea (no-op tail).
    Dispatched by loc_002c1 via cs:[si*2 + 0x20a] for both scene 2 and the recapped scene 6.
]]]
attr[seg000:02f2]: comment = STARS.HSQ
attr[seg000:02f8]: type = code; name = intro2_scene_paul; comment = [[[
    script_2[3] (si=4) and script_2[6] (si=7): Paul talking-head on the red BACK.HSQ panels.
    One-instruction jmp trampoline -> intro_paul_on_red_background (seg000:07ee), the shared draw routine also used by intro stage 17 (stage_17_init in the port).
    Draws BACK.HSQ + the three red vignette panels, calls setup_talking_head(0x2d, 0) to install Paul, then jmp start_room_lip_sync to install the lip-sync frame task.
]]]
attr[seg000:02fb]: type = code; name = intro2_scene_baron; comment = [[[
    script_2[4] (si=5): the Baron Harkonnen talking-head on the red BACK.HSQ background.
    One-instruction jmp trampoline -> intro_26_baron (seg000:09ad), the shared draw routine also used by intro stage 26 (stage_26_init in the port).
    Draws BACK.HSQ + the mirrored side panels + centre overlay, calls setup_talking_head(9, 0x52) to install the Baron, then jmp start_room_lip_sync.
]]]
attr[seg000:02fe]: type = code; name = intro2_scene_back; comment = [[[
    script_2[7] (si=8): the closing INT15.HSQ full-screen image (Paul arriving at the empty palace).
    One-instruction jmp trampoline -> loc_0076a, which:
    gfx_clear_active_framebuffer (redundant after intro2_render_scene cleared, kept for fidelity).
    al=0x61; loc_00739 -> loc_0c2f2 -> open_resource_by_index(INT15) and draw sprite 0 at the origin.
    Dispatched by loc_002c1 via cs:[si*2 + 0x20a] for scene 8.
]]]
attr[seg000:0301]: type = code; name = draw_xplain9_night_sky_frame; comment = [[[
    Bp-callback for the intro2 night-to-day fade transitions (seg000:0264 and
    seg000:028a, both al=0x10 dotted-columns). Clear the active framebuffer,
    then al=0x1b; jmp loc_0c2f2 to open XPLAIN9.HSQ (the night-sky still,
    applying its night palette) and blit sprite 0 at (0, 0). The transition
    driver runs this with the front buffer redirected to fb1 so the night sky
    is composed offscreen for the dotted-columns reveal.
]]]
attr[seg000:0309]: type = code; name = play_CREDITS_HNM
attr[seg000:0317]: targets = segvga:0163
attr[seg000:031b]: ofs_seg = seg000
attr[seg000:0337]: type = [IntroPart; 48]; name = intro_script; ofs_seg = seg000; comment = [[[
    Intro script table: array of IntroPart entries terminated by unk0 = -1.
    Processed by play_intro (seg000:0580). Each entry:
    unk0       = midi sync target consumed by midi_wait_until BEFORE the load function (and -1 = end-of-script terminator).
    load       = function pointer called to set up the stage (e.g. load_VIRGIN_HNM).
    midi       = midi sync target consumed by midi_wait_until AFTER the load function.
    transition = palette transition type, or 0xffff to skip the transition step.
    play       = function pointer called to drive the stage (e.g. play_VIRGIN_HNM, loc_00f66 = no-op).
    wait       = passed to wait_for_pcm_voice_interruptable after play; 0 skips the wait entirely.
]]]
attr[seg000:0577]: type = signed(u16); name = intro_script_end
