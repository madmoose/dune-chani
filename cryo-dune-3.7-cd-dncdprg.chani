attr[seg001:dc66]: type = u16; name = frame_task_dispatch_sp; comment = [[[
    While dispatching, holds sp of the saved {si,cx,bx} frame; 0 when idle.
    Lets add_frame_task/remove_frame_task fix up the in-flight loop ([sp]=si entry ptr, [sp+2]=cx remaining).
]]]
attr[seg001:dc68]: type = u16; name = frame_tasks_last_tick; comment = [[[
    PIT tick counter at the previous poll; rewritten each call via xchg.
    First initialized at game_loop entry. Followed by frame_tasks_count then the frame_tasks array.
]]]
attr[seg001:dc6a]: type = u16; name = frame_tasks_count
attr[seg001:dc6c]: type = [FrameTask; 20]; name = frame_tasks; comment = [[[
    Active timer-task array (max 20); first frame_tasks_count entries are live.
    Entry = { interval, accumulator, callback }. See process_frame_tasks / add_frame_task.
]]]
attr[seg001:dce4]: type = u8
attr[seg001:dce5]: type = u8
attr[seg001:dce6]: type = u8; name = _byte_2D196_in_transition?
