attr[seg000:368b]: name = travel_show_companion_cabin; comment = [[[
    The fly-over companion cabin. mode & 3 == 1 (ornithopter): draw the ORNYCAB
    cabin over the game area and raise the speaking companion as a lip-sync
    talking head. mode & 3 == 2 (worm): re-composite the worm view instead.
    Schedules a minimap recenter (travel_minimap_state |= 1) for when it closes.
]]]
attr[seg000:36d3]: name = run_room_leave_dialogue_scan; comment = [[[
    When pending_room_action != 0 (a room-leave attempt armed by ui_click_move_room), walk
    the standing room-persons (bp = room_person_present_auto_dialogue) so one can
    speak an auto-dialogue line, then clear pending_room_action. The spoken line may clear the
    dialogue_interrupt_gate to abort the move (e.g. Leto topic-4 "where are you
    going so fast", cond 0x1c).
]]]
attr[seg000:36e2]: ofs_seg = seg000
