attr[seg001:dbc8]: type = u16; name = settings_flags; comment = [[[
    Mixer/settings flags word (data_0dbc8). bit 0x1=PCM enabled (check_pcm_enabled),
    bit 0x100=music/MIDI enabled (loc_0ae28), bits 0x8/0x800=subtitle indicators
    available, bits 0x4/0x400=slider drawn-flag preserve.
]]]
attr[seg001:dbca]: type = u8; name = _byte_2D07A_midi_current_loaded
attr[seg001:dbcb]: type = u8; name = _byte_2D07B_current_song_index; comment = [[[
    Index of the currently loaded music song (0 = none).
    Written by play_music at seg000:ada5 to mirror the song-id argument (al).
    Read by play_VIRGIN_HNM and similar HNM playback loops to gate per-frame midi_reset calls.
]]]
attr[seg001:dbcd]: type = u8; name = _byte_2D07D_midi_status; comment = [[[
    Midi driver status byte (mirror of the driver-side status).
    Bit 7 = song is playing.
    Set to the al return of driver function calls: MIDI_Open (play_music) sets it to 0x80 (playing); MIDI_Reset sets it to 0 (stopped). midi_wait_until at seg000:de0c gates on the sign bit: when non-negative (high bit clear) the wait short-circuits and returns immediately.
]]]
attr[seg001:dbce]: type = u16; name = _word_2D07E_midi_measure; comment = [[[
    Midi current measure number (1-based).
    Returned in bx by the driver tick handler (MIDI_Tick) and saved here every tick.
    Incremented every 96 ticks. Used by midi_wait_until to compute song position: (measure << 4) | (((0x60 - ticks_remaining) / 6) & 0xf).
]]]
attr[seg001:dbd0]: type = u16; name = _word_2D080_midi_ticks_remaining; comment = [[[
    Midi ticks remaining in the current measure (counts from 0x60 down to 1).
    Returned in cx by the driver tick handler (MIDI_Tick) and saved here every tick.
    Used together with _word_2D07E_midi_measure to compute the position in midi_wait_until.
]]]
attr[seg001:dbd2]: type = u16; name = music_song_end_tick_stamp; comment = [[[PIT-counter stamp of the first idle-driver sighting after a CD-playlist song ends; music_cd_playlist_service advances the playlist 0xc8 ticks later. 0 = unset; cleared when midi_play_song starts a song (seg000:adba).]]]
attr[seg001:dbd4]: type = u16; name = _word_2D084_framebuffer_front_ofs
attr[seg001:dbd6]: name = _word_2D086_framebuffer_1_seg
attr[seg001:dbd8]: type = u16; name = _word_2D088_screen_buffer_seg
attr[seg001:dbda]: type = u16; name = _word_2D08A_framebuffer_active_seg
attr[seg001:dbdc]: type = u16; name = _word_2D08C_framebuffer_saved_ofs
attr[seg001:dbde]: type = u16; name = _word_2D08E_framebuffer_saved_seg
attr[seg001:dbe0]: type = u16; name = map_popup_ptr; comment = [[[
    Pointer to the primary open popup panel record on the map view (0 = none):
    the rallied-troops title panel (data_0194a), the troop occupation panel
    (data_04710) or the troop info panel (data_018df). The map mouse handlers
    dispatch on which record is open; reset_room_scene_state zeroes it.
]]]
attr[seg001:dbe2]: type = u16; name = map_popup2_ptr; comment = [[[
    Pointer to the secondary open popup panel record on the map view (0 = none),
    used when two panels are up at once (e.g. troop info over the occupation
    panel). Zeroed by reset_room_scene_state.
]]]
attr[seg001:dbe4]: type = u8; name = font_draw_fg_color; comment = [[[The fg (low) byte of the font colour pair at seg001:dbe4. Glyph drawing uses this as the set-bit (foreground) colour; font_draw_bg_color (dbe5) is the clear-bit (background) colour. Word-wide writes (mov [..],cx / dw 0f1fah) set both bytes at once.]]]
attr[seg001:dbe5]: type = u8; name = font_draw_bg_color; comment = [[[The bg (high) byte of the font colour pair at seg001:dbe4 (font_draw_fg_color). Code wanting a background-only change writes this byte directly; glyph drawing uses fg = font_draw_fg_color, bg = this byte (bg 0 = transparent). draw_command_menu_item sets it to 0f3h (the verb-row background) and swaps it with the fg for a highlighted entry.]]]
attr[seg001:dbe6]: type = u8
attr[seg001:dbe7]: type = u8; name = hnm_finished_flag
attr[seg001:dbe8]: type = u16; name = hnm_frame_counter
attr[seg001:dbea]: type = u16; name = hnm_counter_2; comment = [[[
    Frame records read since the clip opened or last hit its loop point.
    Incremented per prefetched frame record (loc_0cc0c/seg000:cc26, and ca44 for frame 0);
    reset by hnm_reset_counters (ce07) and at the loop rewind (cb70, saved into hnm_counter_3).
]]]
attr[seg001:dbec]: type = u16; name = hnm_counter_3; comment = [[[
    The latched loop-pass length: the rewind saves counter_2 here (seg000:cb76) and the
    display-side frame advance (seg000:cc6e) wraps hnm_frame_counter back to 1 once it
    exceeds this, then disarms it (-1) — so hnm_frame_counter counts 1..N per loop pass
    while the prefetcher runs ahead.
]]]
attr[seg001:dbee]: type = u16; name = hnm_counter_4; comment = [[[
    Armed loop-point frame count: the prefetcher treats hnm_counter_2 == hnm_counter_4
    as the loop point (loc_0cb00), so hnm_switch_active_video (ce4b) can redirect the
    stream into another clip at an exact frame. -1 = disarmed (ce13).
]]]
