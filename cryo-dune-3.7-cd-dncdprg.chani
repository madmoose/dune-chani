attr[seg001:1968]: type = u16; comment = [[[
    The cockpit fly-over silhouette signed relative bearing
    (heading - location angle) * 0x20, latched by travel_flyover_detect (41e1)
    and the outdoor-scene detector (loc_04e12). Its overlay-draw consumer is
    absent in this build, so the latch is write-only.
]]]
attr[seg001:196a]: type = u16; comment = [[[
    The fly-over silhouette sprite id (table_196d indexed by the location SAL
    tier), latched alongside data_01968.
]]]
attr[seg001:196c]: type = u8; comment = [[[
    travel_flyover_detect re-arm countdown: after a fly-over is latched the
    detector idles for 6 probe passes (decrementing this) before scanning again.
]]]
attr[seg001:196d]: type = [u8; 5]; name = table_196d; comment = [[[
    The cockpit fly-over silhouette sprite id per location SAL tier
    (calc_sal_index 0..4): SIET 0x11, PALACE 0x10, VILG 0x12, HARK 0x13/0x13.
    Indexed by travel_flyover_detect after the xlat at seg000:424a.
]]]
attr[seg001:1972]: name = room1_backdrop_base; comment = [[[
    Per-SAL outdoor-backdrop base resource, indexed by calc_SAL_index (0..4):
    SIET->DS0 (0x3c), PALACE->DP1 (0x72), VILG->0x7f, HARK->DF1 (0x76) / DH0 (0x84).
    Read by draw_outdoor_backdrop (seg000:3839) as rand_bits[0x1972 + sal_index].
]]]
attr[seg001:1977]: name = room1_backdrop_threshold; comment = [[[
    Per-SAL threshold {5,4,5,4,4} gating draw_outdoor_backdrop (seg000:3834): when
    the computed al reaches it, the backdrop comes from the game_time/map branch
    (seg000:384a) instead of room1_backdrop_base.
]]]
