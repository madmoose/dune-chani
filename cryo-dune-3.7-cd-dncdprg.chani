attr[seg001:dc30]: type = u16
attr[seg001:dc32]: type = u16; name = _word_2D0E2_framebuffer_back; comment = [[[
    Secondary scratch/restore framebuffer used only by the in-game globe/map
    (set_backbuffer_as_frame_buffer makes it active; loc_0c46f restores rects from it).
    Not the double-buffer back buffer (that role is framebuffer_1). Rename pending
    confirmation of its exact globe-vs-map role.
]]]
attr[seg001:dc34]: type = u8; name = mouse_button_state; comment = [[[
    Mouse button state word read by mouse_stuff (seg000:db4c).
    Low byte (data_0dc34): live buttons & 3 from the INT 33,3 poll (bit0 LMB, bit1 RMB).
    High byte (data_0dc35): previous frame's state, latched by mouse_stuff for edge detection.
]]]
attr[seg001:dc35]: type = u8; name = mouse_button_state_prev; comment = [[[
    Previous-frame button state (high byte of the mouse_button_state word).
    mouse_stuff stores the current buttons here each pass; also the click-button byte handlers read as al via [data_0dc35].
]]]
attr[seg001:dc36]: type = u16; name = mouse_pos_x; comment = [[[
    Scaled INT 33h cursor X (horizontal column).
    get_mouse_pos_etc stores the INT 33,3 CX (horizontal) >> x-scaler here.
    redraw_mouse loads it into DX for vga_draw_cursor.
]]]
attr[seg001:dc38]: type = u16; name = mouse_pos_y; comment = [[[
    Scaled INT 33h cursor Y (vertical row).
    get_mouse_pos_etc stores the INT 33,3 DX (vertical) >> y-scaler here.
    redraw_mouse loads it into BX for vga_draw_cursor.
]]]
attr[seg001:dc3a]: name = mouse_clip_region
attr[seg001:dc42]: type = u16; name = mouse_draw_pos_x; comment = [[[
    X column where the cursor was last composited by vga_draw_cursor.
    redraw_mouse compares the new X against it to skip redundant redraws.
]]]
attr[seg001:dc44]: type = u16; name = mouse_draw_pos_y; comment = [[[
    Y row where the cursor was last composited by vga_draw_cursor.
    redraw_mouse compares the new Y against it to skip redundant redraws.
]]]
