attr[seg001:3995]: type = u32; name = pcm_vtable_stop; comment = PCM driver vtable[3] -> dnsdb 0x109 (dnsdb_stop). Stop the current voice (used by pcm_stop_voc).
attr[seg001:3999]: type = u32; name = pcm_vtable_end_loop; comment = PCM driver vtable[4] -> dnsdb 0x10c (dnsdb_end_loop). End repeat loop after current iteration.
attr[seg001:399d]: type = u32; name = pcm_vtable_break_loop; comment = PCM driver vtable[5] -> dnsdb 0x10f (dnsdb_break_loop). Break repeat loop immediately.
attr[seg001:39a1]: type = u32; name = pcm_vtable_queue_next; comment = PCM driver vtable[6] -> dnsdb 0x112 (dnsdb_queue_next). Queue next VOC for gapless/looped playback.
