attr[seg000:09f5]: type = code; name = play_credits; comment = [[[
    Start the scrolling credits: load the first CREDITS.HNM frame, start
    WORMSUIT music (unless CD audio owns the playlist), and install
    frame_task_callback_00a16 to advance one HNM frame per tick into the game
    area. Reached from the book when paging past the last entry.
]]]
