]]]
attr[seg001:4786]: type = u16; name = subtitle_pad_right; comment = Right inner-padding of the subtitle bubble, in pixels. Subtracted from the text width budget alongside subtitle_pad_left.
attr[seg001:4788]: type = u16; name = subtitle_pad_top; comment = Top inner-padding of the subtitle bubble, in pixels. Subtracted from the text height budget (subtitle_text_height_budget) and added to subtitle_pen_y.
attr[seg001:478a]: type = u16; name = subtitle_pad_bottom; comment = Bottom inner-padding of the subtitle bubble, in pixels. Subtracted from the text height budget alongside subtitle_pad_top.
attr[seg001:478c]: type = u8
attr[seg001:478d]: type = u16; name = subtitle_text_height_budget; comment = Inner height of the subtitle bubble: bubble.h - subtitle_pad_top - subtitle_pad_bottom. Reused mid-layout to hold lines*10 (line_count * tall_font_line_height) when vertical centring is on.
attr[seg001:478f]: type = u16; name = subtitle_text_width_budget; comment = Inner width of the subtitle bubble: bubble.w - subtitle_pad_left - subtitle_pad_right. layout_subtitle_lines (seg000:8e16) tracks remaining width in bx against this when wrapping.
attr[seg001:4791]: type = u16; name = subtitle_pen_x; comment = Current pen X for subtitle glyph rendering. Set by draw_speech_bubble to bubble.x0 + subtitle_pad_left (seg001:4784).
attr[seg001:4793]: type = u16; name = subtitle_pen_y; comment = Current pen Y for subtitle glyph rendering. Set by draw_speech_bubble to bubble.y0 + subtitle_pad_top (seg001:4788).
attr[seg001:4795]: type = u16; name = subtitle_line_start_x; comment = Saved line-start X (= initial subtitle_pen_x). Pen X resets to this on each new line.
attr[seg001:4797]: type = u16; name = subtitle_line_start_y; comment = Saved line-start Y (= initial subtitle_pen_y). Pen Y resets to this on each new line.
attr[seg001:4799]: type = u8; name = subtitle_layout_flags; comment = [[[
    Subtitle layout flag bits, defaulted to 9 by subtitle_setup_layout (seg000:8ccd).
    0x01: random text-decoration cleanup pass (loc_08df0).
    0x02: per-line horizontal centring inside the bubble.
    0x04 | 0x08 = 0x0c mask: vertical-centring mode. == 0x08 -> centre block vertically; > 0x08 -> spread lines across the budget; == 0 -> top-align.
    0x01 (bit 0) is also cleared after the first colour-spec pass (seg000:8bcc).
]]]
