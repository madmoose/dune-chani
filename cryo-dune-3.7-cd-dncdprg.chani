attr[seg000:d2bd]: name = run_pending_ui_tasks; comment = [[[
    Force the in-transition flag (_byte_2D196) and drain the deferred UI-task stack
    at data_021da: repeatedly run the top entry (loc_0d2ea) until its status nibble
    is clear or 0ffh, then restore the saved in-transition flag. Lets the current
    screen animation settle before a view switch.
]]]
attr[seg000:d2df]: type = code
attr[seg000:d33a]: name = screen_element_stack_insert; comment = Insert (bp = record buffer, bx = per-frame render func) into the z-ordered screen-element stack (screen_element_stack_ptr / data_021da), sorted by the buffers leading priority byte. Higher-priority entries already on the stack are popped and their render func called as it inserts. loc_0d338 enters with cl = 0ffh.
attr[seg000:d36d]: name = draw_command_menu; comment = Set the top screen-element-stack slot to bp (the menu record buffer), mark the menu records, then fall into redraw_active_command_menu to paint it.
attr[seg000:d397]: name = redraw_active_command_menu; comment = [[[Repaint the active (top-of-stack) verb menu: walk its record buffer (skip header byte, then 4-byte [text_id,handler] records) and draw up to 5 slots via draw_command_menu_item; the 5th slot shows the 0a0h "more" arrow when records overflow. Remaining slots are filled blank. Falls into highlight_hovered_text_action_item (loc_0d410).]]]
attr[seg000:d41b]: name = get_active_screen_element; comment = Return bp = *screen_element_stack_ptr = the top screen-element record buffer (the room buffer at the bottom starts with location_and_room).
attr[seg000:d423]: type = code
attr[seg000:d429]: type = code
attr[seg000:d42f]: type = code
attr[seg000:d434]: type = code
attr[seg000:d439]: type = code
attr[seg000:d43e]: type = code
attr[seg000:d443]: type = code
attr[seg000:d48a]: name = draw_command_menu_item; comment = [[[
    Draw one verb-menu slot (cl = slot 0..4, ax = text_id with state bits) into ui_elements[7+cl].
    Pen x = 5dh, y = ui_elements[7+cl].y0 + 1, small font. text_id & 3fffh = the COMMAND/PHRASE id (0 = blank slot).
    Colour: 0fah enabled (sets flags bit 80h), 0f5h when bit 4000h set (disabled/greyed), fg/bg swapped when bit 8000h set (highlighted); default bg 0f3h.
    Draws a leading space + the resolved string, then fills the rest of the row (x..0e3h, y..y+7) with the bg colour.
]]]
