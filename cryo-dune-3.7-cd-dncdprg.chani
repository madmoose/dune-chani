attr[seg000:35ad]: name = travel_settle_companion_dispatch; comment = [[[
    The per-settle dispatch, run once per travel step (from loc_02e52).
    mode == 0 (loc_035b4): the room auto-dialogue scan.
    mode != 0 (loc_035e9): during a travel, re-detect a location the flight
    passes near (loc_040f9) + the hostile-zone warning; if either armed a room
    action and a companion is aboard, raise the fly-over cabin (loc_0368b) and
    the companion speaks a line (096d8 lip-sync, 03551 dialogue line).
]]]
