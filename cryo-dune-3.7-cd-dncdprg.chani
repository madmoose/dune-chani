attr[seg000:0625]: type = code; name = play_VIRGIN_HNM; comment = [[[
    Play VIRGIN.HNM until complete or user input.
    Each iteration: advance one frame, copy to screen. Once the music has reached measure 8 with a song still loaded, call midi_reset to stop the song (one-shot: midi_reset clears the song-index, so the gating check fails on subsequent frames).
]]]
