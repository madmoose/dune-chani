    field[troop_occupation_dependent_C]: type = u16; comment = Usage depends on occupation, see seg001:0044 for more details.
    field[troop_occupation_dependent_E]: type = u16; comment = Usage depends on occupation, see seg001:0046 for more details.
    field[bitfield_10]: type = bin(u16)
    field[dissatisfaction_and_speech]: type = u16
    field[game_day_of_ralliement]: type = dec(u8)
    field[motivation]: type = dec(u8)
    field[spice_skill]: type = dec(u8)
    field[army_skill]: type = dec(u8)
    field[ecology_skill]: type = dec(u8)
    field[equipment]: type = bin(u8)
    field[population]: type = dec(u8)
end

struct[UIElement]:
    field[x0]: type = dec(u16)
    field[y0]: type = dec(u16)
    field[x1]: type = dec(u16)
    field[y1]: type = dec(u16)
    field[flags]: type = hex(u16)
    field[sprite_id]: type = dec(u16)
    field[func_ptr]: type = ofs16(seg000)
end

struct[UIFriezeSprite]:
