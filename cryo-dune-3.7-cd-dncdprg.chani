attr[seg000:1b0d]: type = code; name = game_loop_sub_01b0d
attr[seg000:1b23]: type = code; name = run_events_for_current_time_period; comment = [[[
    Fire the scheduled events for a newly-entered time period (new_hour_flag,
    consumed here; 16 periods per in-game day). Steps the desert-walk countdown
    (below 0x10 it clears to 0 along with ds:f5), repaints the date/time indicator
    (loc_01a0f) and re-aims the sky palette (loc_038e1), diffs the day part of
    game_time against data_01174 into new_day_flag and runs the new-day hook
    (loc_01c46), then - unless the final attack is at stage 7+ - runs the Chani
    cure check, one period of troop occupation events, the location vegetation
    walk, the get_ingame_time_of_day-indexed action table data_01db3, the open-
    popup content refresh (loc_01c18) and re-stages the CONDIT location block
    (prepare_location_data_for_condit on the saved data_011ce, with subst_id_06
    bracketed around the whole run). The tail (loc_01b8d) steps the night attack
    (loc_01bec) and refreshes whichever main view is up: the map/globe via
    map_view_refresh_after_events when data_046ec is dirty, or the room screen
    when data_0473b asks for a redraw (bit 7: dismiss overlays and re-present
    via loc_00fa7; else draw_room_game_screen), skipped while the WAIT-verb pump
    (data_046da) or a pending room swap owns the screen.
]]]
attr[seg000:1b7d]: targets = seg000:1dd3, seg000:1dd4, seg000:1dd7, seg000:1dda, seg000:1dfe
attr[seg000:1bec]: name = night_attack_period_step; comment = [[[
    Per-period night-attack step (loc_01b8d): while night_attack_stage is up,
    re-check the arrival consequence for the current location (loc_0503c); a
    pending room-screen request is forced to type 6; once the stage has cleared,
    clear the intro-attack task (loc_00b21) and set data_0473b bit 0 so the tail
    redraws the room.
]]]
attr[seg000:1c18]: name = redraw_period_sensitive_view_content; comment = [[[
    Refresh the view content that shows period-dependent numbers. On the full
    map view (data_046eb bit 7): redraw the open troop info panel content and
    the open location popup. In the plain room view (data_046eb == 0) with the
    map/globe ornament up (room_view_toggle bit 7): redraw the globe-ornament
    day/charisma stats (loc_0bdbb).
]]]
attr[seg000:1c46]: type = code; name = run_events_for_current_time_period_new_day_01c46; comment = [[[
    The new-day hook of run_events_for_current_time_period (new_day_flag != 0).
    Resets ds:ff (days since last game-phase change) when game_phase moved (copy
    at ds:fe), else increments it; relocates named NPCs whose location changed
    appearance (seg000:1d66); runs the phase-5c illness picker (seg000:1e43);
    increments the contact-distance byte ds:d5 once it has reached 2; rolls the
    daily spice-production stats: production ds:a6 = stock + spice spent today
    (data_01172, cleared) - stock at last new day (data_01170, reloaded), and the
    better/lower-than-yesterday CONDIT pair ds:b0/ds:b2 from the previous total
    ds:ae; recomputes the potential-harvest value ds:a8 (seg000:1cda) and the
    troop population sums ds:aa/ds:ac (loc_0c02e) and re-formats the stats
    percentage strings (loc_0bf26); finally restocks smuggler inventories: each
    smuggler with field_2 bit 3 refills empty stock slots whose price byte is
    negative with rand 0..3 units.
]]]
attr[seg000:1cab]: ofs_seg = seg001
attr[seg000:1cda]: type = code; name = iterate_over_locations_and_accumulate_number_of_Atreides_locations_and_value_related_to_spice_density; ofs_seg = seg001; comment = [[[
    Recompute the potential-spice-harvest CONDIT word ds:a8: sum spice_density/8
    over all Atreides-held locations (location_is_Atreides_05d36), then add
    rand_iterated(sum/16). The Atreides location count accumulates in dx but is
    not stored.
]]]
attr[seg000:1d10]: type = code; name = randomly_increase_all_harkonnen_troops_head_count; comment = [[[
    End-of-day (time-of-day 0xf) Harkonnen growth: on a set rolling rand bit,
    every Harkonnen troop (bitfield_10 bit 7) with population 1..0xc7 gains one
    man (cap 0xc8).
]]]
attr[seg000:1d16]: ofs_seg = seg001
attr[seg000:1d2e]: ofs_seg = seg001
attr[seg000:1d35]: type = [u8; 49]; name = array_related_to_location_appearances
attr[seg000:1d66]: type = code; name = iterate_over_named_NPCs_and_location_appearances_to_modify_NPCs; ofs_seg = seg001; comment = [[[
    New-day NPC relocation: walk the 12 room_persons records; each named NPC
    parked at a location (location_slot low byte 0x80, high byte = the location
    index, not 0xff) is re-homed when its stored location_and_room no longer
    matches: if the location appearance changed, or its room number exceeds the
    per-appearance top room (array_related_to_location_appearances), the record
    is reset to room 1 of the current appearance.
]]]
