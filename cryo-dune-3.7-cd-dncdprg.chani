attr[segvga:019f]: type = u16; name = crt_status_port; comment = I/O port address of the CRT status register (BIOS data area 40h:63h + 6). Used to poll vsync bit 3.
attr[segvga:01a1]: type = u8; name = vsync_polarity; comment = Non-zero: wait for vsync before DAC writes. Toggled by vga_set_grayscale_mode to track the current vsync edge polarity.
attr[segvga:01a2]: type = u8; name = vsync_state; comment = Last observed vsync bit state (bit 3 of CRT status port). Updated by vga_set_grayscale_mode to establish the baseline for edge detection.
attr[segvga:01a3]: name = fb_base_ofs
attr[segvga:01bd]: type = u8; name = grayscale_mode; comment = [[[0 = color output, non-zero = grayscale. Set by vga_set_grayscale_mode; checked by dac_write to select conversion path.]]]
attr[segvga:01be]: type = u8; name = palette_needs_flush; comment = [[[Dirty flag for the whole palette. Set whenever any palette entry changes; cleared by palette_flush before scanning palette_dirty.]]]
attr[segvga:01bf]: type = [u8; 256]; name = palette_dirty
attr[segvga:02bf]: type = [u8; 768]; name = palette_fade_target; comment = [[[256-entry RGB palette used as interpolation target during palette fades (3 bytes per entry, 6-bit values). Written by vga_set_fade_target_data or vga_save_palette_to_fade_target; read by vga_fade_step as the destination for gradual palette transitions.]]]
attr[segvga:05bf]: type = [u8; 768]; name = palette_cache
attr[segvga:0967]: name = vga_set_mode_13h; comment = BIOS: get current video mode → AL=mode, AH=columns
attr[segvga:096b]: comment = already in mode 13h (320x200, 256 colors)?
attr[segvga:096f]: comment = BIOS: set video mode 13h
attr[segvga:0975]: name = vga_set_grayscale_mode; comment = AL = 0: color mode, non-zero: grayscale mode. Stores to grayscale_mode, reads CRT status port from BIOS data area (40h:63h+6) into crt_status_port, syncs vsync_polarity and vsync_state, then tail-calls palette_flush.
attr[segvga:09b8]: name = vsync_wait; comment = Poll CRT status port (in DX) waiting for vsync bit 3 to change state from AH. Returns CF=1 if transition detected (within ~100 iterations), CF=0 on timeout.
attr[segvga:09d9]: name = vga_get_framebuffer_info; comment = AX = 0xA000 (VGA framebuffer segment)
attr[segvga:09dc]: arg[1] = dec; comment = CX = 64000 = 320*200 (framebuffer size in bytes)
attr[segvga:09df]: comment = BP = 0 (framebuffer offset)
attr[segvga:09e2]: name = vga_set_palette; comment = DS:DX = palette data, BX = byte offset, CX = byte count
attr[segvga:09e9]: comment = DS = ES (caller's segment)
attr[segvga:09eb]: comment = ES = CS (this driver's segment)
attr[segvga:09ed]: ofs_seg = segvga; comment = ES:DI → palette cache
attr[segvga:09f6]: comment = compare new data against cache
attr[segvga:09fa]: comment = mark palette dirty
attr[segvga:0a00]: ofs_seg = segvga
attr[segvga:0a0a]: comment = copy new data into cache
attr[segvga:0a0d]: comment = convert byte offset/count to palette entry index/count
attr[segvga:0a10]: ofs_seg = segvga; comment = mark dirty flags for affected entries
attr[segvga:0a21]: name = palette_byte_range_to_entry_range; comment = [[[Convert a byte range [BX, BX+CX) in the palette cache to a DAC entry range. BX /= 3 → start entry; CX /= 3 → entry count, capped at 256.]]]
attr[segvga:0a40]: name = vga_set_fade_target_data; comment = Write CX bytes from ES:DX into palette_fade_target at byte offset BX. Allows the caller to load an arbitrary palette into the fade target without going through palette_cache.
attr[segvga:0a49]: ofs_seg = segvga
attr[segvga:0a58]: name = vga_copy_palette_to_fade_target; comment = Copy all 768 bytes of palette_cache to palette_fade_target (DS=ES=CS on entry).
attr[segvga:0a5c]: ofs_seg = segvga
attr[segvga:0a5f]: ofs_seg = segvga
attr[segvga:0a62]: arg[1] = dec; comment = 768 / 2
attr[segvga:0a68]: name = vga_save_palette_to_fade_target; comment = Copy the entire palette_cache to palette_fade_target. Preserves registers. Use before a fade sequence to record the starting or ending palette.
attr[segvga:0a76]: name = vga_swap_palettes; comment = Atomically swap palette_cache and palette_fade_target (768 bytes each), then mark palette_needs_flush and all palette_dirty entries as 1. The former fade-target immediately becomes the live palette on the next palette_flush call.
attr[segvga:0a80]: ofs_seg = segvga
attr[segvga:0a83]: ofs_seg = segvga
attr[segvga:0a86]: arg[1] = dec; comment = 768 / 2
attr[segvga:0aa4]: name = vga_fade_save_and_black; comment = [[[Save CX bytes of palette_cache at offset BX into palette_fade_target, then zero those entries in palette_cache and mark them dirty. After this call the live palette is black; call vga_fade_step repeatedly to fade back in from palette_fade_target.]]]
attr[segvga:0ab1]: ofs_seg = segvga
attr[segvga:0ad7]: name = vga_fade_step; comment = [[[Move palette_cache one step toward palette_fade_target and write the result directly to the DAC. AL = total number of steps (0 treated as 1); BX = byte offset into caches; CX = byte count. Each call advances each component by (target - current) / steps; call AL times to reach the target fully. The direct DAC write bypasses palette_dirty.]]]
attr[segvga:0aeb]: ofs_seg = segvga
attr[segvga:0b0c]: name = palette_flush; comment = [[[Upload all dirty palette entries to the VGA DAC. Checks palette_needs_flush; if set, clears it, scans palette_dirty[256] for contiguous dirty runs using repz/repnz scasb, calls dac_write for each run, then clears the dirty array with rep stosw.]]]
attr[segvga:0b24]: ofs_seg = segvga
attr[segvga:0b49]: ofs_seg = segvga
attr[segvga:0b55]: ofs_seg = segvga
attr[segvga:0b68]: name = dac_write; comment = Write CX palette entries starting at index BL to the VGA DAC (ports 3C8h/3C9h). DS:SI points to the RGB data (3 bytes per entry, 6-bit values). If vsync_polarity is set, waits for vsync before writing. In grayscale mode computes (5R + 9G + 2B) >> 4 and outputs that value for R, G, and B.
attr[segvga:0bdc]: name = palette_cycle_water; comment = [[[
    Rotate 64-entry water palette stored at CS:073fh by one entry,
    then flush 64 entries starting at DAC index 128 (dac_write bx=80h, cx=40h).
]]]
attr[segvga:0c04]: type = code; name = blit_mode_noop_0c04
attr[segvga:0c06]: name = vga_set_fb_row; comment = Set fb_base_ofs to the start of row AX (AX * 320).
attr[segvga:0c10]: name = calc_fb_offset; comment = BX = row (clamped to 199), DX = col → DI = fb_base_ofs + row*320 + col
attr[segvga:0c19]: comment = swap: BX = row*256
attr[segvga:0c1d]: comment = DI = row*64
attr[segvga:0c21]: comment = DI = row*64 + row*256 = row*320
attr[segvga:0c23]: comment = restore BX = row
attr[segvga:0c25]: comment = DI += col
attr[segvga:0c2d]: name = vga_plot_pixel; comment = [[[BX = row, DX = col, AL = color; write single pixel to framebuffer]]]
attr[segvga:0c34]: name = vga_get_pixel; comment = Read and return a single pixel from the framebuffer. BX=row, DX=col. Returns the pixel byte in AL.
attr[segvga:0d81]: type = u16; name = sprite_draw_width
attr[segvga:0d83]: type = u16; name = sprite_y_accum
attr[segvga:0d85]: name = vga_draw_scaled_sprite; comment = [[[
    Blit a scaled 4bpp sprite to the VGA framebuffer.
    AX = display width (bits 0-9) | flags (bit13=vflip, bit14=hflip)
    DI = source pixel width (bits 0-8) | flags
    BX = dest row, DX = dest col
    CL = row count, CH = palette base offset
    BP = scale step (fixed-point, shared H and V)
    SI = sprite data (4bpp packed, color 0 = transparent)
]]]
attr[segvga:0dde]: type = u16; name = sprite_src_stride
attr[segvga:0f5b]: name = vga_blit; comment = [[[DS:SI = 4bpp sprite; DI = width×flags; DX = col, BX = row; CH = type, DH = palette base, DL = color mask]]]
attr[segvga:0f5e]: comment = CH >= 0xFE: special mode
attr[segvga:0f74]: comment = [[[width in 4-pixel groups = (DI & 0x1FF + 3) >> 2; patch into blit_kernel]]]
attr[segvga:0f82]: comment = DI = framebuffer offset at (col, row)
attr[segvga:0f8b]: comment = → blit_kernel
attr[segvga:1452]: name = vga_blit_clipped; comment = [[[as vga_blit; BP = clip rect (left, top, right, bottom as u16)]]]
attr[segvga:1476]: comment = clip top: skip rows above clip rect
attr[segvga:1489]: comment = clip bottom: truncate rows below clip rect
attr[segvga:1499]: comment = clip right edge
attr[segvga:14a1]: comment = clip left edge
attr[segvga:14ad]: comment = DI = framebuffer offset at clipped (col, row)
attr[segvga:14b5]: comment = → blit_kernel
attr[segvga:158a]: name = blit_kernel; comment = [[[DI = framebuffer dest; DS:SI = 4bpp sprite rows; CX = height; DH = palette base, DL = color mask; BP patched with width (4-pixel groups)]]]
attr[segvga:158b]: name = blit_width
attr[segvga:158d]: comment = save row start (restored each row for next-row advance)
attr[segvga:158e]: comment = read 2 pixels (low nibble) + 2 pixels (high nibble)
attr[segvga:1591]: comment = color 0 = transparent
attr[segvga:1595]: comment = pixel = nibble + palette_base
