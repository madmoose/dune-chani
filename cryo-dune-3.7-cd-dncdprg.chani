attr[seg000:de0c]: type = code; name = midi_wait_until; comment = [[[
    Block until the current song reaches a target position, or until user input.
    Argument: bx = target position.
    Returns CF=0 (target reached) or CF=1 (user input).
    If [_byte_2D07D_midi_status] sign bit is clear (driver not playing — 0 after midi_reset), returns immediately with al |= 1.
    Position formula (seg000:de20):
    pos = (_word_2D07E_midi_measure << 4) | (((0x60 - _word_2D080_midi_ticks_remaining) / 6) & 0xf)
]]]
