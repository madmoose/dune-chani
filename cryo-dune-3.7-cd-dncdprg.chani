attr[seg001:114e]: type = u16; name = current_location_ptr; comment = [[[
    Pointer to the current location's record in locations[] (0x100 + 0x1c *
    slot), or no location: cleared to 0 by the desert walk-out (seg000:3fdd) and
    the travel departure (seg000:4763); the static init is 0ffffh (also "none")
    until the first scene open. Recomputed on every scene open (loc_008f0: 0xe4 +
    0x1c * location_appearance-hi) and set on walk-in arrival
    (arrive_at_location). Mostly read as the location record (get_map_position,
    equipment/troop scans, "is di the current location" compares); the verb-menu
    code additionally uses the record's address as the room command list's
    identity (seg000:a2aa cmp against command_menu_list, seg000:303b cmp against
    100h = the Atreides palace to show the centre palace-plan button) and reads
    its first two bytes as the nominal menu-origin header
    (set_command_menu_origin).
]]]
attr[seg001:1150]: type = u16; name = last_location_ptr; comment = [[[
    The location record the player is at or last left (static init 0x100 =
    locations[0], the Atreides palace). Set on walk-in arrival
    (arrive_at_location) and travel arrivals; unlike current_location_ptr it is NOT
    cleared when walking out into the desert, so the desert renderer
    (draw_outdoor_backdrop, loc_04d06) can still see the nearby location.
]]]
attr[seg001:1152]: type = signed(u8); name = ui_hud_companion_1
attr[seg001:1153]: type = signed(u8); name = ui_hud_companion_2
