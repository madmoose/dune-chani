attr[seg000:d9d2]: type = code; name = process_frame_tasks; comment = [[[
    process_frame_tasks: per-frame timer-task scheduler.
    First steps the music streamer (loc_0ace6), then polls the task array
    (at frame_tasks_last_tick+4, up to 20 entries of { interval:u16, accumulator:u16, callback:near }).
    A task fires when accumulated elapsed PIT ticks reach its interval; interval 0 = run every frame.
    See add_frame_task / remove_frame_task / clear_frame_tasks.
]]]
attr[seg000:d9dc]: ofs_seg = seg001
attr[seg000:d9df]: comment = [[[cx = previous last_tick; last_tick = now]]]
attr[seg000:d9e1]: comment = bx = elapsed ticks (now - last_tick)
attr[seg000:d9e3]: comment = cx = task_count
attr[seg000:d9e6]: comment = no tasks -> return
attr[seg000:d9eb]: comment = [[[ax = task.interval; si -> task.accumulator]]]
attr[seg000:d9ec]: comment = bp = interval
attr[seg000:d9ee]: comment = ax = ticks_since_last
attr[seg000:d9f0]: comment = ax = elapsed + task.accumulator
attr[seg000:d9f4]: comment = due (acc >= interval) -> fire task
attr[seg000:d9f6]: comment = not due: store updated accumulator, advance to next task
attr[seg000:d9fd]: comment = dispatch finished: clear frame_task_dispatch_sp
attr[seg000:da04]: comment = interval 0 -> run every frame: skip modulo, keep accumulator
attr[seg000:da0a]: comment = accumulator = (elapsed + acc) mod interval -> carry remainder, no drift
attr[seg000:da0e]: comment = si -> task entry start (interval field)
attr[seg000:da14]: comment = publish frame_task_dispatch_sp = sp (saved {si,cx,bx}) for add/remove_frame_task
attr[seg000:da18]: comment = invoke task.callback (near)
attr[seg000:da1e]: comment = advance si to next task entry (6 bytes)
