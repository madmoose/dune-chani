attr[seg001:2222]: type = [u8; 2]; name = ui_hud_companion_blink; comment = [[[
    Per-companion-slot blink countdown bytes ([0] = slot 1, [1] = slot 2).
    npc_assign_companion_slot arms 10h on the filled slot; npc_remove_companion_slot clears the vacated one.
    ui_hud_companion_blink_task decrements once per timer step and blanks the portrait (0ffh) on odd counts, so a fresh companion blinks 8 times.
]]]
