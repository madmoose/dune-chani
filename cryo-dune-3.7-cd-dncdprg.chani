attr[seg000:b714]: ofs_seg = seg001
attr[seg000:b769]: ofs_seg = seg001
attr[seg000:b7c2]: ofs_seg = seg001
attr[seg000:b7cd]: targets = segvga:0142
attr[seg000:b7d2]: name = map_copy_window_row; comment = [[[
    Copy one map row into the ss row buffer at es:di (stride 0xc8) for the
    windowed map blit. cx = the rows tablat offset (negated for northern rows by
    the caller), bx = the tablat half-length (doubled here to the row byte
    length), dx = the window longitude; the longitude cell (high word of
    lng * len) is cached in the tablat entrys +6 scratch word (bp), whose sole
    reader is map_screen_to_position (seg000:b62c) — the globe path instead uses
    +4..+7 as the bands 32-bit rotated offset (vga_globe_init). Rows shorter than
    the window width (data_0dcf2) are centred; the copy wraps around the row end.
]]]
