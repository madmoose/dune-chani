attr[seg001:dbe4]: type = u8; name = font_draw_fg_color; comment = [[[The fg (low) byte of the font colour pair at seg001:dbe4. Glyph drawing uses this as the set-bit (foreground) colour; font_draw_bg_color (dbe5) is the clear-bit (background) colour. Word-wide writes (mov [..],cx / dw 0f1fah) set both bytes at once.]]]
attr[seg001:dbe5]: type = u8; name = font_draw_bg_color; comment = [[[The bg (high) byte of the font colour pair at seg001:dbe4 (font_draw_fg_color). Code wanting a background-only change writes this byte directly; glyph drawing uses fg = font_draw_fg_color, bg = this byte (bg 0 = transparent). draw_command_menu_item sets it to 0f3h (the verb-row background) and swaps it with the fg for a highlighted entry.]]]
