    field[field_6]: type = [u8; 2]
    field[time_joined]: type = u16
    field[time_dismissed]: type = u16
    field[field_c]: type = [u8; 2]
    field[person_index]: type = dec(u8)
    field[flags]: type = hex(u8)
end

struct[Smuggler]:
    field[region]: type = dec(u8)
    field[willingness_to_haggle]: type = dec(u8)
    field[field_2]: type = u8
    field[field_3]: type = u8
    field[harvesters]: type = dec(u8)
    field[ornithopters]: type = dec(u8)
    field[krys_knives]: type = dec(u8)
