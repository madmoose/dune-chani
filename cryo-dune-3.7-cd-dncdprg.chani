attr[seg000:3c21]: comment = 0x0000
attr[seg000:3cd0]: targets = segvga:016c
attr[seg000:3d01]: targets = segvga:016c
attr[seg000:3d12]: type = code; name = sal_draw_character_entry; comment = [[[
    = draw_SAL character entry: a sprite word with (cmd & 0x1ff)==1 marks a
    standing-person slot. Pop the next position marker (back-to-front from
    sal_position_marker_sp); skip if it is 0xff (empty) or room_render_flags
    & 0x81 is set, otherwise draw the person via sal_draw_character.
]]]
attr[seg000:3d2f]: type = code; name = sal_draw_character; comment = [[[
    = sal_draw_character. Record the person screen pos in
    character_x_table/character_y_table[id], open PERS.HSQ (RES_PERS_HSQ),
    map id->sprite via character_id_to_sprite, then draw the sprite pair
    (id*2, id*2+1) at (dx,bx) with pal_offset byte_1C21A_pal_offset.
    Restores the previously open resource on exit.
    The SAL cmd word's flip_x (0x4000) and flip_y (0x2000) bits propagate from
    the room-sheet parser (seg000:3b80) into this function via AH: loc_03b80
    keeps the cmd high byte in AH (only 0x0200 is masked off), the character
    entry path jumps through sal_draw_character_entry, and here 3d4b saves AH
    into CH and 3d72 restores it before draw_sprite. So Part::Character draws
    use the same flip bits as Part::Sprite.
]]]
attr[seg000:3d47]: comment = RES_PERS_HSQ
attr[seg000:3d83]: type = code; name = sal_read_position_markers; comment = [[[
    Build the position-marker array (markers[count], 0xff = empty slot) that
    sal_draw_character_entry consumes. For each set bit of
    persons_in_room ^ persons_travelling_with, sal_assign_position_marker
    places that person index into a slot; an override list at [4778h] takes
    precedence when [4774h]!=0. sal_position_marker_sp (seg001:47f6) ends at
    the last slot.
]]]
attr[seg000:3df4]: type = code; name = sal_assign_position_marker; comment = [[[
    = sal_assign_position_marker. Place person id (al) into a standing slot:
    preferred slot (id+base) % count, else the first free (0xff) slot.
    base = [0c5h] & 0xf, count = position_marker_count (markers at di).
]]]
attr[seg000:3e13]: type = code; name = draw_gradient_section
attr[seg000:3e23]: comment = bx = dy
attr[seg000:3e25]: comment = dx = dx
attr[seg000:3e80]: type = code; name = draw_gradient_section_2
attr[seg000:3e82]: comment = bx = dy
attr[seg000:3f15]: type = code; name = ui_click_room_up; comment = Compass-button click -> ui_click_move_room with bp=1 (exits[0], UP/N).
attr[seg000:3f1a]: type = code; name = ui_click_room_right; comment = Compass-button click -> ui_click_move_room with bp=2 (exits[1], RIGHT/E).
attr[seg000:3f1f]: type = code; name = ui_click_room_down; comment = Compass-button click -> ui_click_move_room with bp=3 (exits[2], DOWN/S).
attr[seg000:3f24]: type = code; name = ui_click_room_left; comment = Compass-button click -> ui_click_move_room with bp=4 (exits[3], LEFT/W).
attr[seg000:3f27]: type = code; name = ui_click_move_room; comment = [[[
    Handle a compass-button click: bp is the 1-based exit offset into the
    current scene record (loc_03efe -> mov dl,[bp+si]). A destination-room exit
    (0x01..0x7F) replaces the room low byte and redraws; 0x80..0xFF is a special
    exit: walk out of the location into the desert (loc_03fd2, stepped by the
    desert_step_deltas word at index -exit).
]]]
attr[seg000:3f49]: comment = [[[
    Outdoor (desert) step: data_04735 = ((data_04735 & 0x7f) + 1, saturated at 0x7f) | 0x80.
    The high bit arms the auto-action dispatch in the game loop; the low bits count steps.
    Falls to the desert-position dispatch at loc_03ff5 with bp = the compass direction (1..4).
]]]
attr[seg000:3f84]: comment = [[[
    si = the current location record (the room verb list IS the location record, base 100h).
    First in-room move inside an unvisited location: set the visited bit 0x10 in locations[].status,
    bump number_of_sietches_visited for sietches, set entering_new_sietch, autosave (create_save_cl 3).
]]]
attr[seg000:3f92]: comment = [[[
    cmp dh,20h sets CF when the location code is below 0x20 (sietches);
    adc folds that carry into number_of_sietches_visited. Cities/palaces (>= 0x20) do not count.
]]]
attr[seg000:3fae]: comment = Arm action code 1 (normal room-leave) after staging pending_destination_room.
attr[seg000:3fca]: comment = Arm action code 5 (leave confirmed past the dialogue-interrupt gate).
attr[seg000:3fd2]: comment = [[[
    Special exit (exit byte 0x80..0xFF): leave the location for the desert.
    bp = -exit indexes desert_step_deltas; the location record is detached from
    current_location_ptr (kept in last_location_ptr), the desert position seeds from
    its map_x/map_y with fine-latitude bh = 0, and current_scene/data_00009 go to
    0xff (no room scene). Falls into the desert-position dispatch below.
]]]
attr[seg000:3ff5]: comment = [[[
    Desert-position dispatch: apply the desert_step_deltas step for bp to
    (dx = longitude, bx = latitude/fine). A nonzero fine-latitude (bh) commits
    the new desert position as location_and_room/location_appearance
    (loc_04057); fine-latitude 0 falls through to the arrival check.
]]]
attr[seg000:4002]: comment = [[[
    Desert arrival check (fine-latitude 0): a location is here when the map byte
    has bit 0x40, find_location_by_map_offset finds its record, and the walked
    longitude dx equals the location's snapped map_x; then arrive_at_location
    enters its room 1. Otherwise commit the position as a plain desert view.
]]]
attr[seg000:401f]: name = arrive_at_location; fn = in location: *Location @si; comment = [[[
    Walk-in arrival at location si from the desert: reset the desert step counter
    (data_04735), make si the current location record (current_location_ptr /
    last_location_ptr), run the occupation check (night attack etc.), mark the
    location discovered, and build the entry-room dx/bx
    (location_entry_room_dx_bx) committed by the fall-through into loc_04057.
]]]
attr[seg000:4057]: name = callback_transition_04057; comment = [[[
    Commit a room move: move companion NPCs (room-person flag bit 0x40) to the destination
    (dx = new location_and_room, bx = new location appearance), record location_and_room,
    rotate current_room into previous_room, store location_appearance.
    No redraw when data_046eb bit 7 is set (ornithopter view); dx == 3002h (Harkonnen
    palace room 2) triggers the game ending; otherwise re-enter draw_room_game_screen
    at the scene-reload entry loc_02dbf.
]]]
attr[seg000:407e]: type = code; name = get_map_position
attr[seg000:409a]: name = find_location_by_map_offset; comment = [[[
    Scan locations[] for the entry whose cached map-byte offset (+6, map_offset)
    equals di (the es:di offset map_func computed). Returns si = the location
    with ZF set on a match; ZF clear (si = end sentinel) when no location claims
    the cell.
]]]
attr[seg000:40ae]: name = location_entry_room_dx_bx; fn = in location: *Location @di; comment = [[[
    Build the arrival scene codes for location di: dx = (appearance << 8) | 1
    (the location's entry room 1), bx = (slot << 8) | 0x80 where slot is the
    1-based index of di in locations[] (the location_appearance in-room form).
]]]
attr[seg000:40b0]: ofs_seg = seg001
attr[seg000:40c3]: type = code; name = move_all_NPCs_whose_bit_6_of_flags_is_set; ofs_seg = seg000
attr[seg000:40c9]: type = code; name = NPC_move_if_flag_bit_6_set_040c9; fn = in npc: *RoomPerson @si, in location_and_room: u16 @dx, in location_slot: u16 @bx
attr[seg000:40d5]: type = code; name = run_travel_departure_npc_scans; comment = [[[
    The NPC half of a travel departure: arm the room-leave dialogue scan
    (pending_room_action = 7, run_room_leave_dialogue_scan), clear data_011ca
    (loc_04ac4), then detach the boarding companions
    (NPC_travel_detach_companion scan).
]]]
attr[seg000:40e0]: ofs_seg = seg000
attr[seg000:40e6]: type = code; name = NPC_travel_detach_companion; fn = in npc: *RoomPerson @si; comment = [[[
    Room-person scan callback for a travel departure: entries with both
    flag 0x40 (companion follows the player) and flag 2 set lose the
    companion flag (NPC_09556) and update the companion HUD slot (NPC_09655).
]]]
attr[seg000:40f9]: name = travel_scan_nearby_location; comment = [[[
    Scan the 9x9 map-cell block around the flight for a location it passes near.
    A qualifying location (discoverable-landmark status bit 0x80, revealed by the
    story phase, bearing within +-0x60 of the heading) arms room action 3 and
    records the location-type caption strings the companion line substitutes.
    The last match in the block wins.
]]]
attr[seg000:4163]: comment = Arm action code 3 (travelling companions are following) before rebuilding the room nav panel.
attr[seg000:4182]: name = travel_route_hostile_zone_check; comment = [[[
    Per-step hostile-zone check along an ornithopter travel route (mode & 3 == 1 only).
    A homing travel (data_011cb 0) to an Atreides destination (location_is_Atreides_05d36)
    is safe: un-grey the map verbs and return. Otherwise probe the terrain byte at the
    current position: unless both 0x30 bits are set (fully hostile) un-grey and return.
    In a hostile cell: arm pending_room_action 4 (the hostile-zone warning) when the
    data_04726 accumulator is empty, grey SKIP TO DESTINATION (flags 0x40), and step the
    accumulator down by 0x20 - on reaching 0 raise pending_room_screen_request 2.
]]]
attr[seg000:41ae]: comment = Arm action code 4 (entering a hostile/non-Atreides zone) to trigger the warning menu.
attr[seg000:41c5]: name = ungrey_skip_to_destination_verb; comment = [[[
    Clear the map verbs heading-adjust accumulator (data_04726) and the SKIP
    TO DESTINATION verb flags (falls into
    set_skip_to_destination_verb_flags with al = 0).
]]]
attr[seg000:41cc]: name = set_skip_to_destination_verb_flags; fn = in flags: u8 @al; comment = [[[
    Store the flags byte into the SKIP TO DESTINATION command template
    (data_021fd, the seg001:21fc records text-id high byte; 0x40 = greyed),
    and into the live command_menu_buf copy (data_01f11) when its first
    records handler is menu_callback_choice_skip_to_destination.
]]]
attr[seg000:41e1]: name = travel_flyover_detect; comment = [[[
    Detect a location the flight passes: scan an 8-cell strip across the heading for a
    location cell (map bit 0x40) whose bearing is within +-0x20 of travel_heading; latch
    its relative angle * 0x20 (data_01968) and SAL-type sprite (data_0196a, table 196d)
    for the cockpit fly-over overlay, with data_0196c as the re-arm countdown.
]]]
attr[seg000:425b]: name = location_mark_discovered; fn = in location: *Location @di; comment = [[[
    First arrival at an undiscovered location (status bit 0x80 set): clear the
    bit, zero discoverable_at_phase, count sietches (appearance < 0x20) in
    discovered_sietch_count, and advance the game phase to 0x10 when the location
    is Tuono-Harg (first_name/last_name word 0x0603).
]]]
attr[seg000:4273]: comment = Tuono-Harg
