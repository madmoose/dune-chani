attr[seg001:0023]: type = u8; name = pending_room_action; comment = [[[
    Pending room-action / leave-dialogue state code (u8), armed when the player picks
    a move-room verb (ui_click_move_room: seg000:3faa stages pending_destination_room
    then sets this to 1). Read each frame by the room loop (loc_035ad) and
    run_room_leave_dialogue_scan to drive standing-NPC auto-dialogue and pick which
    dialogue verb menu to install. Values: 0 idle; 1 normal room-leave; 3 travelling
    companions -> "go towards this place" menu (seg000:3555); 4 hostile/non-Atreides
    zone -> "change destination / ignore warning" menu (seg000:3572); 5/7 other
    leave/move sub-states; 2 come-with-me callback; 11h post night-attack transition;
    >=64h encodes the speaking person (al = 64h + person_index, decoded at seg000:9870
    by sub 64h; the <64h test at seg000:359c separates menu codes from person codes).
    Cleared to 0 after the scan (seg000:36e8) or once the move proceeds.
]]]
attr[seg001:0024]: type = u8; name = for_dialogue_enemies_ds_24; comment = Used by the dialogues of Baron Vladimir Harkonnen, Feyd-Rautha Harkonnen and Emperor Shaddam IV.
attr[seg001:0025]: type = u8; name = number_of_sietches_visited
attr[seg001:0026]: type = u8; name = entering_new_sietch
attr[seg001:0027]: type = u8; name = discovered_sietch_count
attr[seg001:0028]: type = u8; name = number_of_rallied_troops
attr[seg001:0029]: type = u8; name = charisma
attr[seg001:002a]: type = u8; name = game_phase
attr[seg001:002b]: type = u8; name = night_attack_stage; comment = [[[
    Night-attack stage counter.
    0 = inactive (normal room render).
    Incremented at seg000:5058 each time the player enters a room whose data_0000a[room] & 2 flag marks it as a scripted-attack room; cleared to 0 by loc_00b21 (= _clear_night_attack, seg000:b21) and the alternate transition path at seg000:5041.
    1 = the first attack frame (the only `cmp ...,1` site is seg000:83ea); >= 1 keeps the attack scene active.
    While nonzero draw_room_game_screen takes the night_attack_start branch; build_room_command_records swaps in the MASSIVE ATTACK / FIGHT FOR A WHOLE DAY / CALL A WORM verbs in place of TAKE AN ORNITHOPTER; rebuild_and_draw_room_nav_panel skips its per-scene rebuild.
]]]
attr[seg001:002c]: type = u16; name = for_condit_troop_offset_of_location_ds_2c
attr[seg001:002e]: type = u8; name = for_condit_troop_troop_id_ds_2e
attr[seg001:002f]: type = u8; name = for_condit_troop_occupation_and_0xf_ds_2f
attr[seg001:0030]: type = u8; name = for_condit_troop_occupation_ds_30
attr[seg001:0031]: type = u8; name = for_condit_troop_dissatisfactionAndSpeech_and_0xf_ds_31
attr[seg001:0032]: type = u16; name = for_condit_troop_bitfield_10_ds_32; comment = [[[
    Bit   15: saboteurs are here.
    Bit   14: a worm has attacked.
    Bit   13: a worm ate 20 men.
    Bit   12: a worm ate a harvester.
    Bit   11: army training occurs with Gurney Halleck and is much more efficient.
    Bit   10: troop was, or is, in a battle at a fortress.
    Bit    9: repairing equipment.
    Bit    6: currently doing espionage at a Harkonnen fortress.
    Bit    5: troop has won a battle and is currently transforming the fortress into a nice sietch + taking a rest.
    Bit    3: spice production has raised.
    Bit    2: spice production has decreased.
    Bits 1-0: ability increased in spice (1), army (2) or ecology (3).
]]]
attr[seg001:0034]: type = u16; name = for_condit_troop_dissatisfactionAndSpeech_ds_34; comment = [[[
    Bit   15: Ecology skill showing in troop characteristics.
    Bit   14: Army skill showing in troop characteristics.
    Bit   13: Spice Mining skill showing in troop characteristics.
    Bit   12: troop has turned ugly fortress into a sietch.
    Bit   11: troop was cured by Chani.
    Bit   10: troop is ill.
    Bit    9: a small troop has merged with this one.
    Bit    8: troop has discovered and eliminated saboteurs.
    Bit    7: troop is from the south (used for northern / southern Fremen conflicts).
    Bit    5: troop motivation has become too low, men don't believe in Paul anymore => troop refuses to work.
    Bit    4: current conflict between northern and southern Fremen => troop refuses to work.
]]]
attr[seg001:0036]: type = u8; name = for_condit_troop_motivation_modifier_ds_36
attr[seg001:0037]: type = u8; name = for_condit_troop_skill_in_current_occupation_ds_37
attr[seg001:0038]: type = u8; name = for_condit_troop_spice_skill_ds_38
