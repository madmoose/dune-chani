attr[seg001:37fa]: type = [u8; 10]; name = music_cd_playlist; comment = [[[Working CD-playlist order: 9 song numbers + a 0xff terminator. STANDARD ORDER recopies music_cd_standard_order over it; SHUFFLE permutes it in place (music_cd_playlist_shuffle).]]]
attr[seg001:3804]: type = [u8; 10]; name = music_cd_standard_order; comment = The pristine standard CD order (9 songs + 0xff terminator) STANDARD ORDER copies into music_cd_playlist.
attr[seg001:380e]: type = u16; name = music_cd_playlist_cursor; comment = Cursor into music_cd_playlist: points at the NEXT entry to play (music_cd_playlist_advance lodsb + store).
attr[seg001:3810]: type = u8; name = music_playlist_flags; comment = [[[
    Background-music playlist (jukebox) mode flags. Init 0 at seg000:0019.
    bit 0 (0x01): playlist mode. The streamer loc_0ace6 auto-advances the song list at 37fah via the [380eh] cursor and plays each track; also passed as the loop flag to the player vtable [3971h] at seg000:adac. When clear: single-track mode (loc_0ad5e -> loc_0ad75 plays one song, no advance); the single-track timers loc_0adbe/loc_0ae04 run only while clear.
    bit 1 (0x02): shuffle. On playlist (re)start/wrap (loc_0ad21) the song order is randomized by loc_0acbf (rand-based swaps). loc_0ac90 enables both bits (shuffled); loc_0ac97 sets bit 0 and clears bit 1, restoring the ordered master list from 3804h.
]]]
