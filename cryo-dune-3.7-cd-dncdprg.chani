attr[seg001:47a4]: type = u8; name = room_render_flags; comment = [[[
    = scene/room render flags used by draw_SAL and scene setup. Bits 0 and 7
    suppress the in-draw_SAL standing-person draw: sal_draw_character_entry
    (seg000:3d12) skips when (flags & 0x81) != 0. Bit 0 is set by the
    room-byte >= 0x80 branch (loc_037dc, seg000:37df); bit 7 is set during
    draw_SAL setup (seg000:3b28) and cleared at seg000:9868.
]]]
