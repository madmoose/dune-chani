attr[seg000:4988]: name = travel_minimap_setup; comment = [[[
    Set up the flight minimap view: clear the hover state, centre the zoomed view on the
    player, copy travel_minimap_rect into data_046e3_rect and install travel_minimap_redraw
    as the main-view drawing function (falls through into it).
]]]
