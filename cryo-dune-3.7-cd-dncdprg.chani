attr[seg000:5a03]: type = code; name = menu_callback_choice_give_orders_to_troop; comment = [[[
    The dialogue panel GIVE ORDERS TO TROOP verb (setup_npc_dialogue_menu hands it
    to the Fremen-2 person at 90de, text id 0x93): take the speech balloon down,
    bump map_view_reentry_count so this map visit counts as the room troop detour
    (the order menu last slot then reads NO MORE ORDERS instead of CUT CONTACT, and
    choosing it returns to the room via 8763), make the troop behind that person
    (loc_068eb -> fremen2_troop_ptrs[selected_fremen2_index]) the map selection,
    flip room_view_toggle and open the full-planet map (ui_show_globe_map_view),
    then build its contact UI (map_select_troop) exactly as a click on its icon
    would.
]]]
attr[seg000:5a1a]: name = ui_show_globe_map_view; comment = [[[
    Leave the room view and bring up the globe/map view. Forces voice_subtitle_mode
    = 1, tears down the room view (ui_teardown_room_view), sets the zoomed globe
    lat/long and draws the DUNE MAP, fades out (transition dx=0ffffh), then
    tail-jumps ui_hud_head_animate_up. The else-branch of ui_toggle_room_view.
]]]
