attr[seg001:2572]: type = MouseHandlers; name = room_mouse_handlers; comment = [[[
    Room-screen MouseHandlers record (active_mouse_handlers = 2572h, set by select_room_ui_table).
    Only idle (loc_01ae7) does screen-specific work.
    All six button slots are fn_0d917_noop: game_loop hit-tests the HUD element list and dispatches inline.
    game_loop biases the record base by +2 (add si,2) for the right button, so the lmb/release/drag words double as rmb/rmb_release/rmb_drag (+4/+8/+0ch).
]]]
