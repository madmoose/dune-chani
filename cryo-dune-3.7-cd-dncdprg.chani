attr[seg001:487e]: type = u16; name = travel_vehicle_mode; comment = [[[
    The travel vehicle for the pending map travel: 1 = worm (CALL A WORM),
    2 = ornithopter (TAKE AN ORNITHOPTER / seg000:50db). loc_04ec6 refines it
