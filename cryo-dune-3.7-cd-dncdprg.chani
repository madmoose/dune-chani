attr[seg001:0fd8]: type = [RoomPerson; 16]; name = room_persons; comment = [[[
    16-entry, 16-byte table of room-person scenes. Walked by scan_matching_room_person_entries (seg000:36ee).
    Each entry binds a (location_and_room, location_slot) pair to a handler and a 0..15 person_index. build_persons_in_room_records appends one verb-menu record per match (text_id 0x78 + person_index, handler = handler) and OR-es 1 << person_index into persons_in_room.
    flags bit 0x40 splits scans into two passes: template loc_030b9 handles entries with the bit clear, template loc_03120 the ones with it set.
]]]
