attr[seg000:094a]: type = code; name = intro2_scene_sky; comment = [[[
    script_2[2] (si=3): the desert horizon with a low INTDS.HSQ overlay (sky behind the WORMSUIT dunes).
    call draw_sky -- tile SKY/SKYDN.HSQ sprites 0..3 as a 4-row x 8-col grid; set_sky_palette picks the sub-palette via get_sky_palette_id_from_game_time_in_bl (game_time = 2 at intro2 entry -> sub-palette 9 in SKYDN.HSQ).
    ax=0x2d; open_resource_by_index -> INTDS.HSQ (sprite sheet + its palette, the 0x3a transition target).
    ax=0; dx=0; bx=0x3c; draw_sprite_clobbering_bx_dx -> sprite 0 at (0, 0x3c) (the desert/dunes horizon strip).
    Dispatched by loc_002c1 via cs:[si*2 + 0x20a] when intro2 plays scene 3.
]]]
