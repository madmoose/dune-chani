attr[seg000:49f9]: ofs_seg = seg000
attr[seg000:4a00]: name = travel_trail_append; comment = Append the position (dx = longitude, bx = latitude) at the travel_trail_cursor, wrapping the ring at its end.
attr[seg000:4a0c]: ofs_seg = seg000
attr[seg000:4a12]: ofs_seg = seg000
attr[seg000:4a1a]: name = travel_trail_stamp_last; comment = [[[
    Stamp the last appended trail position into the back buffer as a permanent minimap
    trail dot (ICONES 0x2f): skipped while the minimap is hidden (travel_minimap_state
