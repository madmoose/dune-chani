attr[seg001:21da]: name = screen_element_stack_ptr; ofs_seg = seg001; comment = [[[Top-of-stack pointer (a data-segment offset) for the z-ordered active screen-element stack (room at the bottom, menus/dialogue on top). Slots are 4-byte [record_buf_ptr:u16, render_func:u16] at 21be..21d6; 21be = empty. get_active_screen_element (loc_0d41b) returns *top.]]]
