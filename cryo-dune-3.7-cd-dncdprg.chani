attr[seg001:22a8]: type = [dec(u8); 17]; name = talking_head_balloon_x_table; comment = [[[
    Per-talking-head speech-balloon x0, indexed by the head sprite id (si at seg000:91ce).
    setup_lip_sync_data_from_sprite_sheet copies the byte into the x0 word of all three balloon descriptors at data_02224/222c/2234 when the talking head changes, so the balloon clears the speaker portrait (e.g. 0x60=96 for head 0, Leto).
    The descriptors statically hold x0=0x50, which is only in effect before the first head loads.
]]]
attr[seg001:22b9]: name = talking_head_popup_anchor_table; comment = [[[
    Per-head anchor points for the troop-contact popup head box: 4 (x,y) word
    pairs, (0x48,0x3d) (0x54,0x1d) (0x38,0x1a) (0x2f,0x08). Indexed by
    (talking_head_id - 0x0e) * 4 for the generic Fremen heads FRM1..FRM3; the HARK
    head uses the hard-coded byte offset 0x0c (entry 3). loc_09d94 subtracts the
    pair so this point of the head lands on the box origin.
]]]
