attr[seg000:4aad]: type = code
attr[seg000:4ab8]: type = code; name = frame_task_callback_04ab8
attr[seg000:4ad0]: type = code; name = callback_ui_element_04ad0
attr[seg000:4ad7]: type = code; name = callback_ui_element_04ad7
attr[seg000:4aee]: comment = RES_VER_HSQ
attr[seg000:4afd]: name = hnm_present_flight_frame; comment = [[[
    The resource-flag bit 4 full-screen present for the flight clips (from
    hnm_decode_video_frame, seg000:ccee): restore the minimap rect from the back buffer
    into fb1 (travel_restore_minimap_rect), then vga_copy_partial fb1 to the screen.
]]]
attr[seg000:4b0f]: targets = segvga:0136
attr[seg000:4b16]: name = hnm_blit_frame_to_screen; comment = [[[
    Blit the just-decoded HNM frame to the visible screen. If the screen buffer ([dbd8]) and fb1
    ([dbd6]) segments differ (i.e. not decoding straight to screen), copy fb1 (DS:0, 152 rows /
    48640 bytes) to the screen at row 24 (es = screen_seg + 0x1e0) via vga_copy_partial; otherwise
    skip. Called per advanced frame by intro_41_play_VER_HNM (loc_0071d).
]]]
attr[seg000:4b26]: targets = segvga:0136
attr[seg000:4b2b]: name = travel_restore_minimap_rect; comment = [[[Copy travel_minimap_restore_rect from the back buffer into fb1 (loc_0c46f) unless the minimap is hidden (travel_minimap_state bit 0x80); then the cursor-hide tail (loc_0dbca).]]]
attr[seg000:4b32]: ofs_seg = seg001
attr[seg000:4b3b]: name = travel_advance_step; comment = [[[
    One travel movement step: every 16th step runs one time period of events
    (run_events_for_n_time_periods), then the position advances along
    travel_heading (loc_05206) and the companion NPCs follow
    (move_all_NPCs_whose_bit_6_of_flags_is_set); the new encoding is committed
    to location_and_room / location_appearance. Called once by
    map_confirm_travel_and_close and every 0x300 ticks by the travel pump
    (game_loop_sub_04f0c).
]]]
attr[seg000:4b5f]: ofs_seg = seg001
attr[seg000:4bb9]: type = code; name = frame_task_callback_04bb9
attr[seg000:4bc3]: ofs_seg = seg001
attr[seg000:4bc9]: ofs_seg = seg001
attr[seg000:4bd2]: ofs_seg = seg001
attr[seg000:4c89]: targets = segvga:0112
attr[seg000:4cb5]: comment = RES_ICONES_HSQ
attr[seg000:4cc3]: ofs_seg = seg001
attr[seg000:4d00]: ofs_seg = seg000
attr[seg000:4d45]: comment = Play SN5.VOC
attr[seg000:4d4d]: ofs_seg = seg000
attr[seg000:4de3]: targets = segvga:0112
attr[seg000:4def]: ofs_seg = seg000
attr[seg000:4e04]: type = code; name = callback_troop_accumulate_spice_mining_troops_with_harvesters_04e04
attr[seg000:4e8d]: type = code
attr[seg000:4e8e]: name = travel_probe_terrain_ahead; comment = [[[
    Probe the terrain ahead of the flight: from the current position take 6 preview steps
    (travel_step_position on regs only, travel_step_accum preserved), read the map byte,
    step once more and read again, run the fly-over detector (travel_flyover_detect), then
    average the two bytes and fall into travel_select_flight_video.
]]]
attr[seg000:4ec6]: name = travel_select_flight_video; comment = [[[
    Pick hnm_active_video_id from the vehicle and terrain: vehicle < 2 plays the vehicle id
    itself. Ornithopter: terrain low nibble < 8 is sand — keep MNT1 (2) when already on it,
    play the rock-to-sand transition MNT4 (5) from MNT2/3, else back to MNT1; nibble >= 8 is
    rock — the sand-to-rock transition MNT2 (3) from MNT1/MNT4, else the rock loop MNT3 (4).
    The HNM loop point switches clips when hnm_active_video_id differs (seg000:cb7c).
]]]
attr[seg000:4f09]: type = code; name = menu_callback_choice_resume_flight
attr[seg000:4f0c]: type = code; name = travel_pump; comment = [[[
    The in-game travel pump, run once per game_loop pass (seg000:d851). Active while
    travel_active is set and no room swap is pending (data_011ca). Every pass drives one
    flight-HNM frame (hnm_do_frame; the MNT clips take the loc_04afd full-screen present).
    Every 0x300 ticks (travel_step_tick_stamp): travel_advance_step, stamp the previous
    position into the minimap trail (travel_trail_stamp_last), append the new position
    (travel_trail_append), and check arrival (map offset == destination map_offset).
    Not arrived: loc_02e52 settle, consume travel_minimap_state 1 (recenter + redraw via
    travel_refresh_view), draw the live position marker (ICONES 0x30) into the back buffer
    when inside the minimap, or set travel_minimap_state 1 when it left the bounds; then
    travel_probe_terrain_ahead re-picks the flight HNM. Arrived (loc_04fb0): close the HNM,
    disarm, fold the mode flags, count the visit, and commit the arrival (loc_04002).
]]]
attr[seg000:4fc3]: name = travel_finish_at_destination; comment = [[[
    The shared travel-finish tail (the arrival at loc_04fb0 and SKIP TO DESTINATION
    both land here): re-seed person_marker_base, disarm the pump (travel_active 0),
    take the mode flags (an orni travel, mode & 3 == 1, parks the orni on the
    destination pad [di+15h]), clear data_011ca, restore the cursor, rebuild the room
    nav panel, then commit the DESTINATION coordinates and enter it via the desert
    arrival check (loc_04002) - so an unfinished skip still lands at the destination.
]]]
attr[seg000:4ffb]: type = code; name = menu_callback_choice_skip_to_destination; comment = [[[
    SKIP TO DESTINATION (record data_021fc): disarm the game-area hotspot, close the
    flight HNM, force homing mode, then fast-forward up to 0xc8 travel steps. Each step
    checks arrival (map_func offset == destination map_offset -> travel_finish_at_
    destination) and runs travel_route_hostile_zone_check with pending_room_action
    cleared; an armed action breaks out, re-adds 0x20 to data_04726 and re-enters the
    loc_02e52 settle (which shows the warning). Exhausting all 0xc8 steps also finishes
    at the destination.
]]]
attr[seg000:501f]: comment = Clear the action code before each travel_route_hostile_zone_check step.
attr[seg000:5027]: comment = Did the hostile-zone check arm an action? Non-zero breaks the travel loop (loopz keeps stepping while still 0).
attr[seg000:503c]: name = location_related_to_dying_if_arriving_at_fortress_0503c; fn = in location: *Location @di
attr[seg000:5082]: type = code; name = callback_troop_count_Harkonnen_xor_attacking_troops_05082; fn = in troop: *Troop @si, inout count: u16 @dx
attr[seg000:5098]: type = code; name = location_do_accumulation_on_troops_based_on_occupation_05098; ofs_seg = seg000; fn = in location: *Location @di
attr[seg000:50a2]: type = code
attr[seg000:50a5]: type = code; name = menu_callback_choice_back_to_starting_point; comment = [[[
    BACK TO STARTING POINT (record data_02200): reopen the current flight clip at its
    first frame, aim home at last_location_ptr (travel_aim_at_location), clear
    data_011ca/data_011cb and redraw the command panel with the homing verb pair.
]]]
attr[seg000:50c4]: type = code; name = menu_callback_choice_towards_nearest_place; comment = [[[
    TOWARDS NEAREST PLACE (record data_02204): find the nearest non-hidden location
    (iterate_over_locations_and_coordinates), arm a homing travel at it
    (arm_pending_travel), clear data_011ca/data_011cb, force homing mode and redraw
    the command panel.
]]]
attr[seg000:50db]: type = code; name = menu_callback_choice_move_to_location_orni; comment = [[[
    GO THERE FLYING AN ORNI: travel_vehicle_mode = 2, map_ornithopter_mode = 1,
    mode flag 4; falls into the shared GO THERE tail (map_move_to_location_confirm).
]]]
attr[seg000:50ea]: type = code; name = menu_callback_choice_move_to_location_worm; comment = [[[
    GO THERE RIDING A WORM: the worm setup (loc_04285, CALL A WORM), mode
    flag 8; falls into the shared GO THERE tail.
]]]
attr[seg000:50ef]: name = map_move_to_location_confirm; comment = [[[
    The shared GO THERE tail: aim the pending travel at the popups location
    (data_046f8), reset the trail, set game_screen_mode_flags to the mode flag,
    run the departure transition (callback_transition_04057), toggle back to the
    room view and confirm the travel (map_confirm_travel_and_close).
]]]
attr[seg000:5119]: name = adjust_travel_heading; fn = in delta: u8 @al; comment = [[[
    travel_heading += delta, and re-seed the travel step accumulator
    (travel_step_accum = 0x80, half a cell).
]]]
attr[seg000:5124]: name = compass_angle_to_location; fn = in location: *Location @di, out angle: u8 @al; comment = [[[
    The compass angle from the player map position to a locations map cell
    (map_x/map_y through compass_angle_to_map_position).
]]]
attr[seg000:5133]: name = compass_angle_to_map_position; fn = in target_x: u16 @di, in target_lat: u16 @cx, in x: u16 @dx, in lat: u16 @bx, out angle: u8 @al; comment = [[[
    The compass angle from the player map position (dx/bx, get_map_position
    order) to a target map position (di/cx): both deltas are halved once when
    the latitude delta is outside [-0x80, 0x80), then the latitude delta is
    scaled by 256 onto the longitude scale (bh = bl) and the shared
    compass_angle_from_delta math runs on the pair.
]]]
attr[seg000:514e]: name = compass_angle_from_delta; fn = in delta_x: u16 @dx, in delta_y: u16 @bx, out angle: u8 @al; comment = [[[
    Octant-interpolated compass angle of the signed screen delta (delta_x
    right, delta_y down): al = 0 due north, growing clockwise, 0x20 per
    compass point (0x40 east, 0x80 south, 0xc0 west). Interpolates inside
    each octant as 0x20 * minor / major delta. Both deltas zero returns CF
    set with al = 0; otherwise CF clear.
]]]
attr[seg000:5198]: name = travel_heading_deltas; comment = [[[
    Split heading al into per-step deltas (dx = dlng, bx = dlat): the major axis gets
    +-0x20 and the minor the signed remainder, interpolated inside each quadrant.
]]]
attr[seg000:51cb]: name = travel_update_heading; comment = [[[
    Re-aim travel_heading before a step: in fixed-heading mode (travel_heading_mode or
    data_011cb) only the polar guard applies — past |lat| 0x4d a poleward heading is bent
    to due east/west; in homing mode the heading re-aims at travel_destination_ptr
    (compass_angle_to_location).
]]]
attr[seg000:5206]: name = travel_step_position; comment = [[[
    Advance the desert position (dx = longitude, bx = latitude row) one step along
    travel_heading: travel_update_heading re-aims, travel_heading_deltas splits the heading
    into (dlng, dlat) with 0x20 = one full step on the major axis, both scaled by the rows
    lng_units_per_cell. travel_step_accum accumulates fractional latitude (0x100 = one row);
    past 0x1ff the longitude is rescaled to a single-row step. Past |lat| 0x60 the pole
    flips: heading += 0x80 and longitude += 0x8000.
]]]
attr[seg000:5274]: type = code; name = prepare_location_data_for_condit_sub_05274
