attr[seg000:cb00]: comment = [[[
    Prefetch the next frame record. Reaching hnm_counter_4 frame records since the last
    loop rewind counts as the loop point (the orni-arrival approach handoff,
    travel_arrival_landing_sequence seg000:488a), as does exhausting the file.
]]]
attr[seg000:cb1a]: type = code; name = hnm_prefetch
attr[seg000:cb99]: ofs_seg = seg001
attr[seg000:cbb8]: comment = [[[
    When the entered clip carries flag bit 2, splice four stream records pointing into its
    companion resource (video_id + 0x61 = resources 0x63..0x68, MNT1.LOP..PALACE.LOP) — the
    loop-bridge frames played across the loop seam before the body resumes.
    Each record = {size 0x0a, 6d6dh, chunk ofs, chunk seg, chunk len}; the mm decode handler
    (loc_0cd37) follows the far pointer and validates len against the chunk leading size word.
    A .LOP = a small header (self-inclusive size word + empty palette; the resource ptr is
    seated past it, seg000:c18a) + four size-prefixed full-frame video chunks head-to-tail.
]]]
attr[seg000:cc6e]: comment = [[[
    Display-side frame count: hnm_frame_counter increments per consumed record and wraps
    back to 1 once it exceeds hnm_counter_3 (the loop-pass length latched at the rewind,
    seg000:cb76), disarming counter_3 — the per-pass frame number the VOC-loop end check
    (seg000:4937) and the loop-relative waits read.
]]]
attr[seg000:cc85]: type = code; name = check_if_hnm_complete
attr[seg000:cc92]: type = u16; name = word_1CC92_blt_func_ofs
attr[seg000:cc94]: type = u16; name = word_1CC94_blt_func_seg
