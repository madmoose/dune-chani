    Pointer to the active navigation mouse hot-zone Rect (0 = none), read by
    get_mouse_cursor_image_addr for the hand / travel-arrow cursor regions.
    The map screen installs map_view_rect_template here (seg000:4331).
]]]
attr[seg001:dc5a]: type = u16; name = game_clock_tick_base; comment = [[[
    PIT timer-counter reference snapshot. ui_present_room_screen stores the current
    _word_2C32A_pit_timer_callback_counter here; elsewhere elapsed ticks are derived
    by subtracting this base (and it is shifted by constants to consume time).
]]]
attr[seg001:dc5c]: type = u16; name = mouse_drag_armed_element; comment = [[[
    Pointer to the HUD element a press armed for held auto-repeat / release dispatch.
    Set at loc_0d918 when the press lands on a record with flag 0x4000.
    game_loop's held path (loc_0d8da) re-fires it every >=0x32 ticks; the release path (loc_0d944) fires and clears it.
]]]
