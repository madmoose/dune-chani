project[cryo-dune-3.7-cd]:

arch  = 8086
notes = [[[
    This is a disassembly of the main executable DNCDPRG.EXE v3.7 from Cryo
    Interactive's Dune (1992) and the VGA driver DNVGA.BIN, loaded in the
    segment `segvga`.
    
    Disassembly by Thomas Fach-Pedersen - https://mastodon.social/@madmoose
]]]

file[exe]:
    format = exe
    path   = DNCDPRG.EXE
    hash   = sha1:c55e9e35c24941d8590c068c69cb6cee85e4afcb
end

file[dnvga]:
    format = bin
    path   = DNVGA.BIN
    hash   = sha1:4d17083c663a58f03a31476df7c4178da852d044
end

segment[seg000]:
    type   = code
    load   = exe[..0xf4b0]
    assume = ds:seg001
end

segment[seg001]:
    type = data
    end  = 0xdd1e
    load = exe[0xf4b0..0x1336c]
end

segment[segvga]:
    type = code
    load = [0x100..]:dnvga
end

struct[CmdArg]:
    field[name]: type = str(3)
    field[flags]: type = u16
    field[field]: type = ofs16(seg001)
end

struct[CursorShape]:
    field[hotspot_x]: type = dec(u16)
    field[hotspot_y]: type = dec(u16)
    field[and_mask]: type = [bin(u16); 16]
    field[or_mask]: type = [bin(u16); 16]
end

struct[Equipment]:
    field[harvesters]: type = u8
    field[ornithopters]: type = u8
    field[krys_knives]: type = u8
    field[laser_guns]: type = u8
    field[weirding_modules]: type = u8
    field[atomics]: type = u8
    field[bulbs]: type = u8
end

struct[FrameTask]:
    field[interval]: type = dec(u16)
    field[accumulator]: type = dec(u16)
    field[callback]: type = ofs16(seg000)
end

struct[IntroPart]:
    field[wait_init]: type = u16
    field[init]: type = ofs16
    field[wait_play]: type = u16
    field[transition]: type = u16
    field[play]: type = ofs16
    field[wait_pcm]: type = dec(u16)
end

struct[Location]:
    field[first_name]: type = dec(u8)
    field[last_name]: type = dec(u8)
    field[map_x]: type = signed(u16)
    field[map_y]: type = signed(u16)
    field[map_offset]: type = hex(u16)
    field[appearance]: type = u8
    field[troop_id]: type = u8
    field[status]: type = bin(u8)
    field[discoverable_at_phase]: type = signed(u8)
    field[field_C]: type = u16
    field[field_E]: type = u16
    field[spice_field_id]: type = u8
    field[spice_amount]: type = u8
    field[spice_density]: type = u8
    field[field_13]: type = u8
    field[equipment]: type = Equipment
    field[water]: type = u8
end

struct[LocationRoom]:
    field[background]: type = hex(u8)
    field[exits]: type = [u8; 4]
end

struct[MenuEntry]:
    field[id]: type = u16
    field[callback]: type = ofs16(seg000)
end

struct[MenuFence]:
    field[fence]: type = u16
end

struct[MenuHeader]:
    field[flags]: type = u16
end

struct[MouseHandlers]:
    field[idle]: type = ofs16(seg000)
    field[lmb]: type = ofs16(seg000)
    field[rmb]: type = ofs16(seg000)
    field[release]: type = ofs16(seg000)
    field[rmb_release]: type = ofs16(seg000)
    field[drag]: type = ofs16(seg000)
    field[rmb_drag]: type = ofs16(seg000)
end

struct[Rect]:
    field[x0]: type = dec(u16)
    field[y0]: type = dec(u16)
    field[x1]: type = dec(u16)
    field[y1]: type = dec(u16)
end

struct[ResTableEntry]:
