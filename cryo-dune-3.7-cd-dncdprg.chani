attr[seg000:67d8]: ofs_seg = seg001
attr[seg000:67e5]: ofs_seg = seg001
attr[seg000:67ea]: ofs_seg = seg001
attr[seg000:6815]: ofs_seg = seg001
attr[seg000:681c]: ofs_seg = seg001
attr[seg000:6823]: ofs_seg = seg001
attr[seg000:6827]: name = troop_icon_pick_script_moving; fn = in troop: *Troop @si; comment = [[[
    Pick a moving troops icon script: facing = the dominant axis + sign of
    (location map pos - troop gps pos) (0..3, E/W swapped by sign), plus
    4 * the occupation class (troop_get_occupation_bits_2_and_3), indexing the
    16-entry troop_icon_scripts_moving table.
]]]
attr[seg000:682d]: let = location: *Location @di
attr[seg000:686e]: type = code; name = troop_icon_screen_pos; fn = in troop: *Troop @si, out carry: bool @cf; comment = [[[
    The troop icons screen position (out dx = x, bx = y; CF set = no icon).
    Only in full-map mode (data_046eb >= 0x80). A moving troop (occupation bit
    0x40) projects its gps position (map_position_to_screen) and must land in
    (-15..327, -15..159). A stationed troop offsets the visible-location marker
    entry at bp ([bp+2] = x, [bp+4] = y | mode<<8, mode bit 0x80 required) by
    its position slot: (position-1, XOR 8 when the location status has bit 2)
    & 0xf indexes the (dx, dy) byte pairs at troop_icon_slot_offsets.
]]]
