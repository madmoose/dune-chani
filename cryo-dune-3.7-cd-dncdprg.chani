attr[seg000:62ba]: targets = seg000:d096, seg000:d0ff, seg000:d12f, seg000:d16a
attr[seg000:62c6]: comment = Draw last name
attr[seg000:62c9]: name = location_visible_on_map; fn = in location: *Location @si; comment = [[[
    CF clear iff the location (si) is visible on the map view, with dx/bx = its
    screen position: bail (CF set) when no map view owns the screen
    (data_046eb == 0), else project location->map_x/map_y through
    map_position_to_screen_if_visible.
]]]
attr[seg000:62d6]: name = map_position_to_screen_if_visible; comment = [[[
    Project the map position dx (longitude) / bx (latitude) to map-view screen
    coordinates (map_position_to_screen) and bounds-check them against the map
    window (data_046e3_rect): CF clear + dx/bx = screen position iff inside.
]]]
attr[seg000:6314]: name = map_draw_player_position_sprite; comment = [[[
    Draw the "you are here" ICONES sprite 0x4c on the map view at the players
    projected position (map_position_to_screen_if_visible), anchored 13 px left
    and one sprite height up from the point; restores the previously active
    resource bank afterwards.
]]]
attr[seg000:633b]: name = map_draw_vegetation_marks; comment = [[[
    Draw the vegetation tufts over the full map view: for each visible map band
    from zoomed latitude - 0x12 down (map_position_to_screen_if_visible sets CF
    when a band leaves the window), draw the bands vegetation marks
    (map_draw_vegetation_marks_row). Run by map_build_and_draw_location_markers
    in full-map mode (data_046eb bit 0x80) before the location markers.
]]]
attr[seg000:634d]: name = map_draw_vegetation_marks_row; comment = [[[
    Draw one map bands vegetation marks: project the bands centre column, then
    walk the map row east (map_draw_vegetation_marks_east) and west
    (map_draw_vegetation_marks_west) from it.
]]]
attr[seg000:636a]: name = map_draw_vegetation_marks_east; comment = [[[
    Walk the map row east from the centre column (4 screen px per map cell,
    wrapping at the row end) until data_046e3_rect.x1, drawing a tuft sprite
    (map_draw_vegetation_mark_sprite) on every vegetation cell
    (map byte & 0x30 == 0x10).
]]]
attr[seg000:639a]: name = map_draw_vegetation_marks_west; comment = [[[
    Westward twin of map_draw_vegetation_marks_east: walk the map row left from
    the centre column until data_046e3_rect.x0.
]]]
attr[seg000:63c7]: name = map_draw_vegetation_mark_sprite; comment = [[[
    Stamp one vegetation tuft, centred + clipped (loc_0c343): ICONES sprite 0x79
    when the next cell east is also vegetation, else 0x78, jittered 0..3 px in x
    and y from the cells map offset so the tufts do not grid-align.
]]]
attr[seg000:63f0]: type = code; name = iterate_over_all_locations_upon_new_day; comment = [[[
    The per-new-day location/ecology walk (no-op unless new_day_flag). Pass 1:
    every location with status bit 0x20 (vegetation program active) and growth
    level [di+0x1b] below 0xfa grows by 1 + half the count of stage-1 vegetation
    cells in the 6 map cells around its map offset (loc_0642e), capped at 0xfa.
    Pass 2 (loc_065b6): a 0x46-step LFSR walk (state cs:data_065b4, taps 0x402)
    over map columns; every visited cell in stage 1 ((cell & 0x30) == 0x10) is
    promoted to stage 2 (the drawable vegetation tufts, map_build_and_draw_
    location_markers). Any promotion while the full map view is up (data_046eb
    bit 7) bumps the data_046ec dirty counter so the view refreshes.
]]]
attr[seg000:63fb]: ofs_seg = seg001
attr[seg000:642e]: type = code; name = count_stage1_vegetation_cells_near_offset; comment = [[[
    Count the map cells in stage-1 vegetation ((cell & 0x30) == 0x10) among the 6
    cells at map offset si-1 .. si+4. Returns the count in dx.
]]]
