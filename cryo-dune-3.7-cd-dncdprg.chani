attr[seg000:01e0]: type = code; name = callback_troop_location_set_troop_location_info_from_given_location_001e0; fn = in troop: *Troop @si, in location: *Location @di, in gps_coordinates_1: signed(u16) @dx, in gps_coordinates_1: signed(u16) @bx; comment = [[[
    Reset troop location information from the given location.
    Set southern Fremen bit for the Habbanya, Oxtyn, Cielago, Sihaya and Celimyn regions.
]]]
attr[seg000:01f1]: comment = Set southern / northern Fremen information.
attr[seg000:01f3]: comment = If from Arrakeen, Carthag or Tuono: do nothing.
attr[seg000:01f5]: comment = Flip bit 7 once.
attr[seg000:01fa]: comment = If from Habbanya or Oxtyn: do nothing more.
attr[seg000:01fc]: comment = Flip bit 7 twice.
attr[seg000:0201]: comment = If from Tsympo, Bledan, Ergsun or Haga: do nothing more.
attr[seg000:0203]: comment = [[[
    Flip bit 7 a third time.
    Troops affected by this flip are from Cielago, Sihaya or Celimyn.
]]]
