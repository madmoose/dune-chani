]]]
attr[seg000:4a21]: ofs_seg = seg001
attr[seg000:4a2b]: ofs_seg = seg000
attr[seg000:4a31]: ofs_seg = seg000
attr[seg000:4a5a]: name = travel_trail_redraw; comment = [[[
    Redraw every trail dot (ICONES 0x2f) from the ring into the back buffer, oldest to
