attr[seg000:4994]: ofs_seg = seg001
attr[seg000:49a0]: name = travel_minimap_redraw; comment = [[[
    Redraw the flight minimap into the back buffer: windowed map (data_046eb briefly 1),
    nested border (draw_map_view_border), location markers, and the destination marker
    (ICONES 0x2e) when travel_destination_ptr is visible; then back to fb1 active.
]]]
attr[seg000:49d4]: name = travel_enter_minimap_view; comment = Re-enter the flight minimap view: travel_minimap_setup + travel_trail_redraw. Run by map_screen_cleanup when travel_minimap_state > 0 and the CHANGE DESTINATION close.
