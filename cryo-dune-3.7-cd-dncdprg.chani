attr[seg000:aba9]: name = wait_for_narration_voice_clip; comment = [[[
    Block until the narration voice clip drains, pumping the ab92 monitor
    body each PIT tick (it restores the ducked score once playback ends),
    with a 1000-tick timeout; both exits fall into
    set_voc_pcm_is_not_playing.
]]]
