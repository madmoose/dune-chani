attr[seg001:2275]: type = [u16; 4]; name = subtitle_bubble_rect_dusk; comment = [[[
    Bubble rect for the suppress_sky_240_255 / dusk-or-night subtitle strip, used by the intro2 WORMSUIT narration cutscenes.
    Layout {x0=0, y0=153, w=320, h=47} -- a full-width band across the bottom of the screen. subtitle_setup_layout picks this when suppress_sky_240_255 != 0, with paddings zeroed and font_draw_fg_color = 6.
]]]
attr[seg001:227d]: type = u8; name = _byte_227D_suppress_sky_240_255; comment = [[[
    Suppress-secondary-sky-span flag (static init 1). loc_039b9 / loc_0391d / loc_0398c write+fade the extra 16 sky colours into palette entries 240..255 (bx=0x2d0, cx=0x30) only when this is 0.
    play_intro never clears it (the =0 write is at seg000:029d in play_intro2), so the whole first intro -- including stage 29's MTG3 flyover -- runs with the 240..255 span suppressed. play_intro2 / in-game code zero it; nested operations re-suppress with inc/dec (loc_00d4e/0d89, 1566/1579, 168e).
]]]
attr[seg001:227e]: type = u16
attr[seg001:2280]: type = [u8; 16]; name = sky_palette_id_table; comment = [[[
    Hour-of-day -> sky sub-palette id table indexed by the low nibble of game_time (the time-of-day phase).
    Values: 8 8 9 9 9 9 9 9 9 9 9 0Ah 0Ah 0Bh 0Bh 0Bh.
    get_sky_palette_id_from_game_time_in_bl reads it with xlat and adds ((game_time>>2) & 0x1c) so each whole-day rollover shifts the gradient by 4 sub-palettes.
]]]
