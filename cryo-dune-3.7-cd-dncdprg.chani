attr[seg001:000a]: type = u8; name = bitfield_Paul_events; comment = [[[
    Bit 6: ridden a worm.
    Bit 5: met Liet Kynes.
    Bit 4: met Stilgar; now able to recruit army troops.
    Bit 3: has heard about the Water of Life: set by Stilgar's dialogue when seeing a wind trap, read by Jessica's dialog.
    Bit 1: has drunk the Water of life: set by Stilgar's dialogue when drinking the Water of Life.
    Bit 0: has had a vision: set at game phase 14.
]]]
attr[seg001:000b]: type = u8; name = current_room
attr[seg001:000c]: type = u8; name = pending_destination_room; comment = [[[Pending destination room low byte: ui_click_move_room writes it (seg000:3faa) before the room-leave dialogue scan; CONDIT condition 0x1c reads the word at 0x0c.]]]
attr[seg001:000d]: type = u8; name = previous_room
attr[seg001:000e]: type = u16; name = persons_met
attr[seg001:0010]: type = u16; name = persons_travelling_with
attr[seg001:0012]: type = u16; name = persons_in_room
attr[seg001:0014]: type = u16; name = persons_talking_to
attr[seg001:0016]: type = u16; name = for_condit_ds_16
attr[seg001:0018]: type = u8; name = for_condit_ds_18; comment = FLAGS: 0x04 - Left Jessica in the desert
attr[seg001:0019]: type = u8; name = line_spoken_this_conversation; comment = [[[
    Per-conversation "a dialogue line has been spoken" flag (0 = no line spoken yet, 0xFF once one is).
    0 at conversation start (cleared in loc_093df at seg000:9417).
    0xFF once any dialogue line is presented (fire_event...spoken_dialogue_lines at seg000:a092).
    A fallback dialogue line tests this == 0 in its CONDIT condition, so the
    fallback is presented only when no other line was presentable (nothing said yet).
]]]
