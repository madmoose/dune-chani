attr[seg000:6946]: name = troop_icon_hit_test; ofs_seg = seg001; comment = [[[
    Hit-test (dx, bx) against the troop icons, top-most (last-listed) first,
    skipping the flag-0x40 highlight ring. Returns si = the icon, di = its
    owner troop; CF set only when the troop is rallied (occupation < 0x80).
]]]
attr[seg000:697c]: name = map_focus_troop_icon; comment = [[[
    Spawn the selected-troop highlight ring: gated on the troop having an icon
    (troop_find_icon) and, when stationed, a visible location marker
    (location_find_visible_marker); spawns the troop_icon_focus_ring_script
    icon at the troops position, flags it 0x40 (draw last, not clickable) and
    stores it in troop_icon_focused_ptr.
]]]
attr[seg000:6994]: ofs_seg = seg001
attr[seg000:69a3]: name = map_remove_focused_troop_icon; comment = [[[
    Remove the selected-troop highlight ring: take troop_icon_focused_ptr and
    troop_icon_remove it.
]]]
attr[seg000:69b3]: type = code; name = menu_callback_choice_map_troop_dialogue_change_troop_occupation; comment = [[[
    The CHANGE / SELECT TROOP OCCUPATION verb: pick the occupation submenu for the
    troop occupation class (troop_get_occupation_bits_2_and_3_0693b = (occ & 0xf)
    >> 2: 0 spice -> seg001:216e, 1 army -> 2182, >= 2 ecology -> 21a6; nibble 2
     awaiting orders -> the plain SELECT menu 215a; an army troop already on
    espionage, nibble 5 -> the fortress ATTACK menu 219a). Grey rules: ESPIONAGE
    needs a Harkonnen area within 0x1e, GO & SEARCH FOR EQUIPMENT needs game_phase
    >= 0x10, SPECIALIZE IN ECOLOGY needs bitfield_Paul_events bit 0x20. Staged
    with the no-op cleanup nullsub_00f66.
]]]
