attr[seg000:bfe3]: type = code; name = compute_area_controlled_percentages; comment = [[[
    Recompute the area-controlled CONDIT percentages from the map vegetation
    bits: over every map cell (minus the 0x187-byte polar tail), cells with
    (cell & 0x30) == 0x30 count as Harkonnen area, other nonzero stages as
    Atreides. ds:a2 = round(atreides * 100 / cells) + 1, ds:a4 = round(
    harkonnen * 100 / cells). (Distinct from the position-to-offset map_func at
    seg000:b58b.)
]]]
