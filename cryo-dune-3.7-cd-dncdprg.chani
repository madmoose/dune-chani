attr[seg000:c6ad]: type = code; name = troop_icons_update_dirty_rect; comment = [[[
    Repaint a dirty rect of a troop-icon view (si = the rect): lift the cursor
    when it overlaps, clip to the sprite clip rect, restore the clipped rect to
    the screen from the fb2 snapshot, collect the icons intersecting it and draw
    them in the order the troop_icon_draw_order_func picks (fifo, or by depth on
    the map), then redraw the HUD head and any open popup panels the rect
    touches (loc_0c7a2).
]]]
