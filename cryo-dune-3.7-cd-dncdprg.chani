attr[seg000:c921]: type = code; name = hnm_get_res_entry_by_index; ofs_seg = seg001; fn = in id: u16 @ax, out entry: *ResTableEntry @bx; comment = [[[
    Return entry = RESOURCE_LIST_HNM[id], the ResTableEntry for an HNM video id.
    The table maps a video id to a pointer to {flags:u16, name:cstr}.
]]]
attr[seg000:c924]: comment = id is a word index, so scale by 2.
attr[seg000:c928]: comment = Dereference the table slot to the ResTableEntry pointer.
attr[seg000:c92b]: type = code; name = hnm_open_and_load_palette; comment = Latch the requested HNM video id.
attr[seg000:c92e]: comment = Close any video still open.
attr[seg000:c931]: comment = Reset the read/decode buffer pointers.
attr[seg000:c934]: comment = Clear the "playback finished" flag.
attr[seg000:c939]: comment = Zero the frame counter, then fall through to read the header.
attr[seg000:c93c]: type = code; name = hnm_read_header; comment = Latch the active video id from the requested id.
attr[seg000:c942]: comment = Look up this video's resource table entry.
attr[seg000:c945]: let = entry: *ResTableEntry @bx; comment = [[[
    entry->unk0 is the resource flag word (current_hnm_resource_flag). High byte
    = playback rate for clips without SD audio (data_0dbff, cae5). Low byte is a
    decode/streaming bitfield:
      bit 0 (0x01) loop: at the mm end marker rewind to body instead of finishing (cb61).
      bit 1 (0x02) unused.
      bit 2 (0x04) alt frame-offset slot +0x10 (c9b6) and, on loop, companion resource video_id+0x61 (cbb8).
      bit 3 (0x08) loop clip-chain/redirect with a stored rect (cb88).
      bits 4-5 (0x30) full-screen copy modes rerouting the blit (ccae): bit 4 -> loc_04afd (copy whole fb1 to screen), bit 5 -> loc_04aeb (VER text handler).
      bit 6 (0x40) stage to the back buffer instead of framebuffer_1 (cac3) and skip the prefetch warm-up (ca48).
      bit 7 (0x80) streaming/prefetch-ahead: extra prefetch + skip the 0x800-byte read alignment (ca67/cb20).
]]]
attr[seg000:c94a]: comment = entry->name is the HNM file name.
attr[seg000:c94d]: comment = [[[
    Open from DUNE.DAT or as a standalone file; aborts to DOS on failure.
    Returns handle in bx, start offset in dx:ax, size in bp:cx.
]]]
attr[seg000:c950]: comment = Save handle, file start offset (lo/hi) and remaining size (lo/hi).
attr[seg000:c963]: comment = Preserve the buffer cursors across the header read.
attr[seg000:c96b]: comment = Read the 2-byte header size into ax.
attr[seg000:c970]: comment = [[[
    If the header would run past the framebuffer-sized scratch area,
    restart the read buffer at offset 0.
]]]
attr[seg000:c980]: comment = Header size minus the 2 size bytes already consumed.
attr[seg000:c985]: comment = Read the rest of the header (palette + frame-offset table).
attr[seg000:c988]: comment = Restore the buffer cursors.
attr[seg000:c992]: comment = Point es:si at the header just read.
attr[seg000:c996]: comment = [[[First word = offset to the frame-offset table; clamp to the scratch area.]]]
attr[seg000:c9a4]: comment = Force the next palette upload regardless of the last bank used.
attr[seg000:c9a9]: comment = Upload the palette entries that follow.
attr[seg000:c9ad]: comment = Skip the 0ffh padding after the palette to reach the frame-offset table.
attr[seg000:c9b4]: comment = [[[Slot 0 by default; slot at +10h when resource flag bit 2 is set.]]]
attr[seg000:c9bf]: comment = Read the dword relative offset of the first frame (cx = lo, bx = hi).
attr[seg000:c9c6]: comment = [[[
    Cache the absolute file position of the first frame for hnm_prefetch:
    body_offset = file_offset + rel, body_remain = file_remain - rel.
]]]
attr[seg000:c9e6]: comment = Clear carry: header read succeeded.
attr[seg000:c9e8]: type = code; name = hnm_do_frame_skippable
attr[seg000:c9f4]: type = code; name = hnm_do_frame_and_check_if_frame_advanced
attr[seg000:ca01]: type = code; name = hnm_close_resource; comment = [[[
    Close the current HNM file handle and clear it.
    The shared DUNE.DAT handle is never closed here. Resets the frame counter.
]]]
attr[seg000:ca03]: comment = Take and clear the handle.
attr[seg000:ca09]: comment = Nothing open -> done.
