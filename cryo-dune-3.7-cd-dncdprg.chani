attr[seg001:4880]: type = u16; name = lng_units_per_cell_table; comment = [[[
    99 words, one per |latitude| 0..0x62: the longitude units spanned by one map
    cell of that row = round(0x10000 / the rows tablat byte length), ties rounded
    down. Built at startup (seg000:00e7) right after the TABLAT byte-swap;
    location_distance_from_player and the walk/troop range checks divide by it.
]]]
attr[seg001:4948]: type = u16; name = RESOURCE_TABLAT
attr[seg001:494a]: type = u16
attr[seg001:494c]: type = u16; name = _dword_23DFC_globe_rotation; comment = [[[
    The fp field of in-memory TABLAT entry 0 (RESOURCE_TABLAT+4), holding the globe rotation phase as a 16.16 fixed point:
    the integer word is the phase in 1/398ths of a revolution (0..0x18d), the fraction word stays 0.
    set_globe_tilt_and_rotation seeds it with the high word of 398 * longitude; globe_rotation_increment_ax steps and wraps the phase word.
    recalculate_globe_rotation_table reads it (with the 0x8000 rounding bias) to derive every other row fp.
]]]
attr[seg001:4c60]: type = u16; name = RESOURCE_GLOBDATA
attr[seg001:593a]: name = _unk_24DEA_unk_table_2
attr[seg001:8b77]: name = globe_tilt_window_table; comment = [[[
    196-word globe tilt window table rebuilt by build_globe_tilt_window_table on every tilt change.
    vga_globe_setup reads it at [middle (+0xc4) + 2 * outline latitude byte] to map a GLOBDATA outline latitude to a (section, latitude) pair under the current tilt.
]]]
