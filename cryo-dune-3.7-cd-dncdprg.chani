attr[seg000:5344]: type = code; name = iterate_over_locations_and_coordinates; fn = in lng: u16 @dx, in lat: u16 @bx, out nearest: *Location @di, out distance: u16 @bp; comment = [[[
    Find the nearest non-hidden location (status bit 0x80 clear) to the map position
    dx/bx: distance = max(|d_map_x| >> 8, |d_map_y|) with a byte compare picking the
    larger; strictly-closer wins, di = the best record, bp = its distance.
]]]
