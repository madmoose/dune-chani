project[cryo-dune-3.7-cd]:

arch  = 8086
notes = [[[
    This is a disassembly of the main execuable DNCDPRG.EXE v3.7 from Cryo
    Interactive's Dune (1992) and the vga driver DNVGA.BIN, loaded in the
    segment `segvga`.
    
    Disassembly by Thomas Fach-Pedersen - https://mastodon.social/@madmoose
]]]

file[exe]:
    format = exe
    path   = DNCDPRG.EXE
    hash   = sha1:c55e9e35c24941d8590c068c69cb6cee85e4afcb
end

file[dnvga]:
    format = bin
    path   = DNVGA.BIN
    hash   = sha1:4d17083c663a58f03a31476df7c4178da852d044
end

segment[seg000]:
    type   = code
    load   = exe[..0xf4b0]
    assume = ds:seg001
end

segment[seg001]:
    type = data
    end  = 0xdd1e
    load = exe[0xf4b0..0x1336c]
end

segment[segvga]:
    type = code
    load = [0x100..]:dnvga
end

struct[CmdArg]:
    name  = str(3)
    flags = u16
    field = ofs16(seg001)
end

struct[CursorShape]:
    hotspot_x = dec(u16)
    hotspot_y = dec(u16)
    and_mask  = [bin(u16); 16]
    or_mask   = [bin(u16); 16]
end

struct[FrameTask]:
    interval    = dec(u16)
    accumulator = dec(u16)
    callback    = ofs16(seg000)
end

struct[IntroPart]:
    unk0       = dec(u16)
    load       = ofs16
    midi       = dec(u16)
    transition = u16
    play       = ofs16
    wait       = dec(u16)
end

struct[Location]:
    first_name            = dec(u8)
    last_name             = dec(u8)
    map_x                 = signed(u16)
    map_y                 = signed(u16)
    another_x             = u16
    apparence             = u8
    troop_id              = u8
    status                = bin(u8)
    discoverable_at_phase = signed(u8)
    field_C               = u16
    field_E               = u16
    spice_field_id        = u8
    spice_amount          = u8
    spice_density         = u8
    field_13              = u8
    harvesters            = u8
    ornithopters          = u8
    krys_knives           = u8
    laser_guns            = u8
    weirding_modules      = u8
    atomics               = u8
    bulbs                 = u8
    water                 = u8
end

struct[PalaceRoom]:
    background = hex(u8)
    npcs       = [u8; 4]
end

struct[ResTableEntry]:
    unk0 = u16
    name = cstr
end

struct[RoomPerson]:
    location_and_room = hex(u16)
    location_slot     = hex(u16)
    handler           = ofs16(seg000)
    not_just_padding  = [u8; 8]
    person_index      = dec(u8)
    flags             = hex(u8)
end

struct[Smuggler]:
    region                   = dec(u8)
    willingness_to_haggle    = dec(u8)
    field_2                  = u8
    field_3                  = u8
    harvesters               = dec(u8)
    ornithopters             = dec(u8)
    krys_knives              = dec(u8)
    laser_guns               = dec(u8)
    weirding_modules         = dec(u8)
    harvesters_price         = dec(u8)
    ornithopters_price       = dec(u8)
    krys_knives_price        = dec(u8)
    laser_guns_price         = dec(u8)
    weirding_modules_price   = dec(u8)
    not_just_padding         = [u8; 4]
end

struct[Troop]:
    troop_id                   = dec(u8)
    next_troop_id              = dec(u8)
    position                   = dec(u8)
    occupation                 = hex(u8)
    offset_of_location         = hex(u16)
    gps_coordinates_1          = signed(u16)
    gps_coordinates_2          = signed(u16)
    time_period_of_ralliement  = dec(u16)
    field_C                    = u16
    field_E                    = u16
    bitfield_10                = bin(u16)
    dissatisfaction_and_speech = u16
    game_day_of_ralliement     = dec(u8)
    motivation                 = dec(u8)
    spice_skill                = dec(u8)
    army_skill                 = dec(u8)
    ecology_skill              = dec(u8)
    equipment                  = bin(u8)
    population                 = dec(u8)
end

struct[UIElement]:
    x0        = dec(u16)
    y0        = dec(u16)
    x1        = dec(u16)
    y1        = dec(u16)
    flags     = hex(u16)
    sprite_id = dec(u16)
    func_ptr  = ofs16(seg000)
end

struct[XY]:
    x = dec(u16)
    y = dec(u16)
end

