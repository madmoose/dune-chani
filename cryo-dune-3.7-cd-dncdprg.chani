attr[seg001:1179]: type = [u16; 10]; name = comm_sighting_list; comment = The COMM-room person-sighting words ((location index << 8) | person id), comm_sighting_count entries, appended by comm_add_person_sighting.
attr[seg001:118d]: type = u16
attr[seg001:1190]: type = u8; name = vision_message_count
attr[seg001:1191]: type = [u16; 20]; name = vision_message_queue; comment = [[[The queued vision messages, vision_message_count entries of (message id, location ptr or 0), max 10; queue_vision_message_with_location appends (deduplicated, oldest dropped at overflow), dequeue_vision_message consumes from the front.]]]
attr[seg001:1193]: type = u16
attr[seg001:11bb]: type = u8
attr[seg001:11bc]: type = u8; name = harkonnen_raid_suppress_once; comment = [[[Nonzero suppresses the next Harkonnen raid check; consumed (cleared) by actions_time_in_day_4 (seg000:1f83).]]]
attr[seg001:11bd]: type = u16; name = dialogue_played_log_head; comment = [[[Head (write cursor) of the dialogue-played log: the growing 0-terminated word list at cs:0xaa.. of packed (entry_index | lip_sync_id << 11) records of replayable spoken lines (appended at seg000:a07f; pre-filled by the Ctrl+V cheat seg000:b270).]]]
attr[seg001:11bf]: type = u16; name = book_bookmark_ptr; comment = [[[
    Bookmark: cs offset of the current page word in the dialogue-played log
    (0xaa = first entry); persists while the book is closed.
]]]
attr[seg001:11c1]: type = u16
attr[seg001:11c3]: type = u16
attr[seg001:11c5]: type = u16; name = travel_destination_ptr; comment = [[[
    The pending/active travel destination location ptr (0 = none). Set by
    arm_pending_travel; map_screen_cleanup keeps game_screen_mode_flags while
    it is set; the step re-aim (loc_051cb) and the arrival (seg000:4fd8)
    read it; cleared at seg000:4ff2.
]]]
attr[seg001:11c7]: type = u8; name = travel_heading; comment = [[[
    The travel compass heading (0 north, clockwise, 0x20 per compass point).
    Seeded by arm_pending_travel; re-aimed at the destination each step when
    travel_heading_mode == 0 (loc_051cb); reversed by BACK TO STARTING POINT
    (seg000:526a += 0x80).
]]]
attr[seg001:11c8]: type = u8; name = travel_heading_mode; comment = [[[
    1 = fixed compass heading (a desert-cell click); 0 = home toward
    travel_destination_ptr, re-aiming each step (loc_051cb).
]]]
attr[seg001:11c9]: type = u8; name = game_screen_mode_flags; comment = [[[
    Bitfield selecting the active non-room screen/mode (book/map/dialogue/copy-
    protection etc): set to 4 or 8, tested with masks 3 and 0fh, cleared to 0 when
    the plain room view is active. ui_enter_room_view returns early while nonzero.
]]]
attr[seg001:11ca]: type = u8
attr[seg001:11cb]: type = u8; name = travel_no_location_dest; comment = [[[
    Nonzero (0xff) when the travel has no location destination — a directional
    flight on a fixed compass heading across open desert (fly east/west/etc),
    where travel_destination_ptr holds only the starting point (last_location_ptr).
    0 for a homing flight to a real location. Set by arm_pending_travel (dec at
    seg000:494c) when the map click misses any location (hover >= 0xfff0); cleared
    by loc_050be. Gates the map travel verb (BACK TO STARTING POINT vs SKIP TO
    DESTINATION), the polar heading guard (travel_update_heading), and the route
    hostile-zone check (travel_route_hostile_zone_check).
]]]
attr[seg001:11cc]: type = u16; name = travel_step_accum; comment = [[[
    The travel steps 8.8 sub-cell accumulator, re-seeded to 0x80 (half a
    cell) by adjust_travel_heading; consumed by the step math (loc_05206).
]]]
attr[seg001:11ce]: type = u16
attr[seg001:11d0]: name = troop_icon_panel_heights; comment = [[[
    The 4 location popup panel heights by class (location_popup_class):
    88, 60, 30, 0.
]]]
