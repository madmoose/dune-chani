attr[segvga:1888]: name = vga_draw_cursor; comment = [[[DS:SI = cursor shape (hotspot u16×2, AND mask u16×16, OR mask u16×16); DX = x, BX = y]]]
attr[segvga:1889]: comment = x -= x_hotspot, clamp to 0
attr[segvga:1890]: comment = y -= y_hotspot, clamp to 0
attr[segvga:1896]: comment = height = 16, clip to bottom edge
attr[segvga:18a4]: comment = DI = framebuffer offset at (x, y)
attr[segvga:18ac]: comment = width = min(16, 320 - x) — clip to right edge
attr[segvga:18c9]: comment = BX = A000:FA00 — background save area (just past visible framebuffer)
attr[segvga:18dd]: comment = OR mask row (SI+0x20, 16 rows past AND masks)
attr[segvga:18e0]: comment = AND mask row
attr[segvga:18e5]: comment = save background pixel pair to FA00 buffer
attr[segvga:18ee]: comment = [[[AND bit set → keep background; clear + OR bit set → draw color 0x0F]]]
attr[segvga:190e]: comment = write pixel pair
attr[segvga:1911]: comment = handle odd width: one remaining pixel
attr[segvga:192f]: comment = advance DI to next row
attr[segvga:1940]: name = vga_restore_cursor; comment = restore background saved by vga_draw_cursor
attr[segvga:1949]: comment = load cursor position and clipped dimensions
attr[segvga:195f]: comment = DS:SI = A000:FA00 (background save area)
attr[segvga:1962]: comment = copy cursor_width bytes from save area back to framebuffer row
attr[segvga:1968]: comment = advance to next row (320 bytes)
attr[segvga:1979]: name = vga_clear_rect; comment = fill rect with color 0
attr[segvga:197b]: name = vga_fill_rect; comment = [[[DS:SI = rect (x1 u16, y1 u16, x2 u16, y2 u16); AL = fill color]]]
attr[segvga:197d]: comment = AH = AL: pack color into word for rep stosw
attr[segvga:1984]: comment = DI = framebuffer offset at (x1, y1)
attr[segvga:198a]: comment = width = x2 - x1
attr[segvga:198f]: comment = height = y2 - y1
attr[segvga:1998]: comment = [[[BP/2 = word count; carry = odd pixel]]]
attr[segvga:199e]: comment = even width: fill BP words per row
attr[segvga:19a4]: comment = advance to next row (320 bytes)
attr[segvga:19ae]: comment = odd width: fill BP words + 1 trailing byte per row
attr[segvga:19bd]: comment = 1-pixel wide: fill one byte per row stepping 320
attr[segvga:19c9]: name = vga_fb_copy_rect; comment = [[[
    Copy a rect between two positions within the framebuffer.
    [bp+0]=src_col, [bp+2]=src_row, [bp+4]=width, [bp+6]=height
    [bp+8]=dst_col, [bp+a]=dst_row
]]]
attr[segvga:19f7]: name = vga_clear_screen; comment = clear 64000 bytes at ES:0 (VGA framebuffer)
attr[segvga:1a07]: name = vga_draw_line; comment = [[[DX=x1, BX=y1, DI=x2, CX=y2; AL=color; BP=16-bit line pattern; SI=clip rect ptr (x_min,y_min,x_max,y_max as u16)]]]
attr[segvga:1a1a]: comment = save start position
attr[segvga:1a24]: comment = Δy = |y2-y1|, Δx = |x2-x1|
attr[segvga:1a3a]: name = bresenham_line_ymajor
attr[segvga:1a6d]: comment = [[[rol pattern bit; plot if set and within clip rect]]]
attr[segvga:1a86]: name = bresenham_line_xmajor
attr[segvga:1abf]: comment = [[[rol pattern bit; plot if set and within clip rect]]]
attr[segvga:1adc]: name = bresenham_line; comment = [[[BX=Δy, DX=Δx; draws using pattern bitmask in data_segvga_0019a, clipped to data_segvga_00198 rect]]]
attr[segvga:1ae0]: comment = Δy=0: horizontal line
attr[segvga:1af0]: comment = Δx=0: vertical line
attr[segvga:1b6a]: comment = clip check passed: plot pixel
attr[segvga:1b7c]: name = vga_copy_screen; comment = copy 64000 bytes from DS:0 to ES:0 (screen buffer copy)
attr[segvga:1b8c]: name = vga_copy_rect_ds; comment = [[[SI = source segment; otherwise as vga_copy_rect]]]
attr[segvga:1b8e]: name = vga_copy_rect; comment = [[[BX = row, DX = col, BP = width, AX = height; copy rect from DS:offset → ES:offset]]]
attr[segvga:1b91]: comment = [[[BP/2 = word count per row; carry = odd width]]]
attr[segvga:1b99]: comment = copy BP words per row from DS:row_start → ES:row_start
attr[segvga:1ba1]: comment = advance to next row
attr[segvga:1bca]: name = vga_blit_checkerboard; comment = [[[DS:SI = source; DI = (width & 0x1FF) | position_flags; BX = row, DX = col; write to every other col and row (checkerboard transparency)]]]
attr[segvga:1bcc]: comment = width in pixels
attr[segvga:1bd5]: comment = DL = height (rows)
attr[segvga:1bda]: comment = copy pixel, skip next dest column
attr[segvga:1bdf]: comment = advance 640 bytes: skip one full row
attr[segvga:1be7]: name = vga_copy_partial; comment = [[[SI = source segment; copy 48640 bytes (152 rows) from DS:0 → ES:0]]]
attr[segvga:1bf5]: name = vga_draw_glyph; comment = [[[DS:SI = 1bpp bitmap (1 byte/row, MSB first); AX = (bg<<8)|fg; CX = (height<<8)|width_bits; BX = row, DX = col]]]
attr[segvga:1bf8]: comment = BL = fg color, BH = bg color
attr[segvga:1bfa]: comment = DH = height (rows), DL = width (bits per row)
attr[segvga:1c00]: comment = BH=0: transparent background
attr[segvga:1c04]: comment = opaque path: draw fg and bg pixels
attr[segvga:1c06]: comment = load one row of glyph bits
attr[segvga:1c09]: comment = [[[AL = fg; shift next bit out MSB-first]]]
attr[segvga:1c0f]: comment = bit clear: use bg color
attr[segvga:1c14]: comment = advance to next row
attr[segvga:1c1f]: comment = transparent path: skip bg pixels, write only fg bits
attr[segvga:1c2a]: comment = bit clear: skip pixel (transparent)
attr[segvga:1c38]: comment = bit set: write fg pixel
attr[segvga:1c46]: name = vga_grab_rect; comment = [[[Copy a rectangle from the framebuffer into caller's buffer (ES:SI on entry). Stack params [bp]: x1, y1, x2, y2 (right/bottom exclusive). Swaps DS/ES to read from A000 and writes row-by-row; row stride = 320.]]]
attr[segvga:1c76]: name = vga_put_rect; comment = [[[Copy a pixel buffer into a rectangle on the framebuffer. Complement of vga_grab_rect. Stack params [bp]: x1, y1, x2, y2 (right/bottom exclusive); DS:SI = source pixel data. ES must be A000; DI set by calc_fb_offset.]]]
attr[segvga:1cb6]: name = vga_globe_init; comment = [[[
    Globe draw entry (from map_func_gfx): al = skip flag, ds:si = MAP centre ptr, bp = RESOURCE_TABLAT, es = fb1.
    Patches data_segvga_01e4a with 2 NOPs (al=0, store every pixel) or a short jmp (al!=0, skip the pixel stores),
    then caches its working pointers in cs: 01ca0/01ca2 = map ptr, 01ca4 = TABLAT (rotation table),
    01ca6/01ca8 = GLOBDATA+1 (the two outline stream cursors), 01caa = GLOBDATA+0xcda (the per-x latitude/cell tables, 200 bytes per x column),
    01cac = globe_tilt_window_table middle (+0xc4), 01cae/01cb0 = left/right pixel store cursors seeded around the centre (0x649f/0x64a0 = row 80, x 159/160), 01cb4 = the +/-320 row step.
    Then draws the centre row (loc_segvga_01d5a) and loops vga_globe_setup once per outline row until done.
]]]
attr[segvga:1d07]: name = vga_globe_setup; comment = [[[
    Draw one globe outline row (both x directions from the centre column).
    Per pixel (loc_segvga_01d85): outline latitude byte -> globe_tilt_window_table word -> (section, latitude);
    GLOBDATA tables at 01caa give the rotation-table row index ([x*200 + lat], /2 -> *8 = entry) and the cell offset within the row (+0x64);
    the TABLAT entry supplies row start bx, len cx and rotation fp hi word dx; the section flips ax = len - ax and/or bx = -bx (the four quadrant branches),
    then the map byte at [centre + wrapped offset] maps to a colour: al = (v & 0x0f), +12 if (v & 0x30) == 0x10 and al < 8, +0x10 into the globe palette block (1e4c..1e5c).
    Mirrored west/east pixels store via the 01cae/01cb0 cursors (std/cld stosb).
]]]
attr[segvga:1ec9]: type = code
attr[segvga:1f4c]: name = vga_draw_map_zoomed
attr[segvga:2384]: name = map_globe_edge_insets; comment = [[[
    18 per-row edge insets for map rows at |latitude| 0x46..0x57: the number of
    pixels vga_blit_shaded trims from each side of the row, giving the windowed
    map its curved-globe top/bottom edges. The trimmed span is drawn as shade
    bytes 0x17..0x1c framed in black.
]]]
attr[segvga:23eb]: name = vga_blit_shaded; comment = [[[
    Blit the ss map row buffer (si, stride 0xc8, di = width, cx = height) to the
    framebuffer at (dx,bx), bottom to top. ax = the top rows latitude: rows at
    |latitude| >= 0x46 are trimmed by map_globe_edge_insets on both sides (black +
    shade bytes 0x1c,0x19 / 0x18,0x17) for the curved globe edge. Row pixels are
    remapped from palette bank 0 to bank 1: (cell & 0x0f) + 0x10.
]]]
attr[segvga:2441]: name = vga_draw_landscape; comment = [[[Render a pixel map through an xlat palette-remap table at [BP]. BL=dest row, DX=dest col, DI=row count; source at DS:SI with 200-byte row stride. BH=0: plain remap, then if grayscale_mode update 16 DAC entries at index 80 from CS:8BFh. BH≠0: animated remap (maps pixels to palette range 0x71-0x74) and cycles the xlat table between each row to animate. Each pixel is only drawn if it matches both its next-column and next-row neighbor (interior-only rendering).]]]
attr[segvga:25a9]: type = [ofs16(segvga); 31]; name = transition_dispatch_table; comment = 31 word offsets, one per transition effect type (AX mod 62, step 2). Each entry points to a different transition function.
attr[segvga:25e7]: name = vga_transition; comment = [[[Perform a transition effect between two framebuffers. AX selects the transition type: forced even and wrapped mod 62 to index one of 31 handlers in transition_dispatch_table. CX=152 passed to the handler; caller's SI/DS/ES saved as source/destination buffer state before dispatch.]]]
attr[segvga:2616]: targets = segvga:2628, segvga:26b0, segvga:272e, segvga:2757, segvga:279a, segvga:2a0f, segvga:2a10, segvga:2a15, segvga:2a68, segvga:2ad0, segvga:2ad1, segvga:2cc7, segvga:2cc8, segvga:2cc9, segvga:2cca, segvga:2d42, segvga:2d43, segvga:2d44, segvga:2dc0, segvga:2dc3, segvga:2eea, segvga:2f53, segvga:2f71, segvga:2f87, segvga:2f9f, segvga:30f0, segvga:30f1, segvga:3130
attr[segvga:2628]: type = code; name = transition_fade_in_from_black; comment = [[[
    Effect 0x36: fade in from black to the new image.
    Clears palette_cache + DAC to zero, blits the new framebuffer, then steps the live palette up toward palette_fade_target over ~96 frames.
    Reuses the fade kernel at loc_segvga_0264d.
]]]
attr[segvga:2635]: ofs_seg = segvga
attr[segvga:2667]: ofs_seg = segvga
attr[segvga:26b0]: type = code; name = transition_fade_out_to_black; comment = [[[
    Effect 0x38: fade out to black, then snap to the new image+palette.
    Calls the palette-ramp helper loc_segvga_026e3 with ax=64, dx=544 to step every entry toward zero, then copies the new framebuffer in and reloads palette_cache from palette_fade_target before palette_flush.
]]]
attr[segvga:26ce]: ofs_seg = segvga
attr[segvga:26d3]: ofs_seg = segvga
attr[segvga:26d6]: arg[1] = dec; comment = 768 / 2
attr[segvga:26ee]: ofs_seg = segvga
attr[segvga:272e]: type = code; name = transition_fade_through_black; comment = [[[
    Effect 0x3a: swap palette buffers, fade current to black, then fade up to the new palette.
    First swaps a 0x17d-word window of palette state (offsets 5c2..7bc <-> 2c2..4bc), then runs the fade-out kernel (loc_segvga_026e3 ax=85 dx=790) and jumps into the fade-in loop loc_segvga_0264d.
    Implemented in dune-rs as transition_3a_fade_through_black.
]]]
attr[segvga:2757]: type = code; name = transition_instant_swap; comment = [[[
    Effect 0x30: no transition. palette_flush then rep movsw the full 0x5f00-word framebuffer from the source page to the destination page.
    Implemented in dune-rs as transition_30.
]]]
attr[segvga:2768]: type = u16; name = transition_col; comment = Current column position for the active wipe transition. Initialized to 8, incremented by 8 per frame, wraps back to 8 at 530. Covers the 320px screen width in ~65 steps.
attr[segvga:276a]: type = u16; name = transition_frame; comment = Frame counter within the active wipe transition. Initialized to 1, incremented by 1 per frame, resets in sync with transition_col.
attr[segvga:276c]: type = code; name = transition_tick; comment = Advance the wipe transition by one frame. Reads transition_col/transition_frame, erases the previous edge (via loc_segvga_02802 with col-8), draws the new edge (via loc_segvga_027e6 at current col), then increments and saves both state vars.
attr[segvga:279a]: type = code; name = transition_diagonal_wipe; comment = [[[
    Effect 0x12: synchronous full-screen diagonal wipe.
    Runs the same transition_kernel/transition_draw_edge engine that transition_tick advances one frame at a time, but in a tight loop covering col=8..0x3c0 with 3 vsync waits per step. Sweeps the whole 0x12c0-tall framebuffer in one call.
]]]
attr[segvga:27e6]: type = code; name = transition_draw_edge; comment = Draw the leading edge of the wipe at current transition_col/transition_frame. Patches return SMC to 2823h then calls transition_kernel with dx=176, bx=91.
attr[segvga:2802]: type = code; name = transition_erase_edge; comment = Erase the previous edge (col-8, frame-1) before advancing. Patches return SMC to 2887h then calls transition_kernel with dx=176, bx=91.
attr[segvga:2823]: type = code
attr[segvga:28ec]: type = code; name = transition_kernel; comment = Low-level wipe rendering kernel. CX=column position, SI=frame counter, DX=176 (band height), BX=91 (band y-offset). Renders one vertical band of the transition between the two framebuffers.
attr[segvga:29eb]: targets = segvga:2823, segvga:2887
attr[segvga:29f5]: targets = segvga:2823, segvga:2887
attr[segvga:29fd]: targets = segvga:2823, segvga:2887
attr[segvga:2a07]: targets = segvga:2823, segvga:2887
attr[segvga:2a0f]: type = code; name = transition_noop_2a0f; comment = Effect 0x0a: no-op (retf). Dispatched but does nothing.
attr[segvga:2a10]: type = code; name = transition_dissolve_lfsr_slow; comment = [[[
    Effect 0x3c: LFSR pixel-dissolve, 80 pixels per vsync (slow variant).
    Uses cx as a 16-bit LFSR (shr cx,1 / xor ch,0x44 feedback) to walk every byte of the framebuffer in pseudo-random order; movsb copies that pixel from src to dst.
    Shared body at loc_segvga_02a18; this entry presets dx=0x50.
]]]
attr[segvga:2a15]: type = code; name = transition_dissolve_lfsr_fast; comment = [[[
    Effect 0x08: LFSR pixel-dissolve, 150 pixels per vsync (fast variant).
    Shared body with loc_segvga_02a10 at loc_segvga_02a18; this entry presets dx=0x96.
]]]
attr[segvga:2a68]: type = code; name = transition_expanding_box; comment = [[[
    Effect 0x02: rectangle expanding from screen center.
    Anchors at (bx=0x4a, dx=0x9c) via calc_fb_offset, then calls loc_segvga_02ab0 in widening passes (dx=1,2,3,...) that stamp 4x4 cell strips downward and step outward. Continues until dx reaches 0x26.
]]]
attr[segvga:2ad0]: type = code; name = transition_noop_2ad0; comment = Effect 0x2c: no-op (retf). Dispatched but does nothing.
attr[segvga:2ad1]: type = code; name = transition_horizontal_slide; comment = [[[
    Effects 0x0c, 0x0e: horizontal 8-pixel-strip slide.
    Direction chosen by sign of caller dx: positive walks bx from cx down to -0x138 (slide right-to-left via loc_segvga_02bac/loc_segvga_02b56); negative walks bx from -0x138 up to 0x98 (slide left-to-right via loc_segvga_02c02/loc_segvga_02b56).
    Preloads a column lookup via loc_segvga_02c52 from src or dst page accordingly.
]]]
attr[segvga:2cc7]: type = code; name = transition_noop_2cc7; comment = Effect 0x32: no-op (retf).
attr[segvga:2cc8]: type = code; name = transition_noop_2cc8; comment = Effects 0x16, 0x18: no-op (retf).
attr[segvga:2cc9]: type = code; name = transition_noop_2cc9; comment = Effect 0x14: no-op (retf).
attr[segvga:2cca]: type = code; name = transition_vertical_curtain; comment = [[[
    Effect 0x00: vertical band-wipe with a color-7 (grey) leading edge.
    Sign of dl picks scroll direction. Each frame: rep movsw the dst region down (or up) by 0xa00 bytes (8 lines), fill the freed band with color 0x707 via rep stosw, vsync via loc_segvga_0253d. Continues until si crosses the screen.
]]]
attr[segvga:2d42]: type = code; name = transition_noop_2d42; comment = Effect 0x1a: no-op (retf).
attr[segvga:2d43]: type = code; name = transition_noop_2d43; comment = Effect 0x20: no-op (retf).
attr[segvga:2d44]: type = code; name = transition_accelerating_strips; comment = [[[
    Effects 0x22, 0x24: strip reveal with shrinking spacing.
    Walks framebuffer offsets adding a phase that doubles when bx wraps, with ax growing by 6 per step (loc_segvga_02d9d skip-wait). The strips appear sparse at first and pack tighter as the transition progresses.
]]]
attr[segvga:2dc0]: type = code; name = transition_dotted_columns_tall; comment = Effect 0x34: same body as transition_dotted_columns but preloads cx=0xc8 (200 = full screen height) before falling through to loc_segvga_02dc3.
attr[segvga:2dc3]: type = code; name = transition_dotted_columns; comment = [[[
    Effect 0x10: stippled-column reveal driven by the offset table at segvga:2fd7.
    First pass writes color 0 into a dotted pattern (stosb at stride 3) for cx/4 rows down. After the 0xffff sentinel, a second pass copies the actual source pixels through the same dot pattern.
]]]
attr[segvga:2e2c]: type = code
attr[segvga:2e2f]: ofs_seg = segvga
attr[segvga:2e66]: name = spiral_offset_table; comment = [[[
    Spiral order for transition_spiral (effect 0x2a): 65 word framebuffer
    offsets, one per (col,row) cell of an 8x8 pixel block (ofs%320 = col
    phase 0..7, ofs/320 = row phase 0..7). Walking every 8th col (40 dots)
    and every 8th row (cx/8 = 19 groups) from each offset stamps that cell of
    every block. The 64 unique cells are ordered as an inward spiral and tile
    the 152-row game area exactly once (64*40*19 = 152*320); entry 0x0140
    repeats, so one cell is stamped twice. 0xffff at segvga:2ee8 ends the
    forward walk.
]]]
attr[segvga:2eea]: type = code; name = transition_spiral; comment = [[[
    Effect 0x2a: spiral dissolve driven by spiral_offset_table (segvga:2e66).
    Each 8x8 pixel block reveals its 64 cells in inward-spiral order (outer
    ring first, down to the centre), all blocks in lockstep. First pass
    blacks out a 0x28-wide pattern at stride 8 per row, cx/8 (19) rows tall,
    walking the table backward. After the 0xffff sentinel it palette_flushes
    and runs a second pass that copies the real source pixels into the same
    spiral.
]]]
attr[segvga:2eed]: ofs_seg = segvga
attr[segvga:2ef6]: ofs_seg = segvga
attr[segvga:2f53]: type = code; name = transition_mosaic_full; comment = [[[
    Effect 0x06: 3-level mosaic with palette swap.
    Fine -> medium -> coarse pixelation of the OLD image (loc_segvga_02fc1 / loc_segvga_02ff9 / loc_segvga_03031), then palette_flush, then coarse -> medium -> fine de-pixelation of the NEW image.
    Helpers operate on 2x2, 4x4 and 8x4 block sizes respectively.
]]]
attr[segvga:2f71]: type = code; name = transition_mosaic_oneway; comment = [[[
    Effect 0x2e: one-way mosaic reveal with no palette swap.
    Runs coarse-to-fine: loc_segvga_03031 x3 (8x4 blocks), loc_segvga_02ff9 x2 (4x4), loc_segvga_02fc1 x2 (2x2). Seven passes total, no palette_flush midway.
]]]
attr[segvga:2f87]: type = code; name = transition_mosaic_medium; comment = [[[
    Effect 0x26: 2-level mosaic with palette swap.
    Fine -> medium pixelation of the OLD image (loc_segvga_02fc1, loc_segvga_02ff9), palette_flush, medium -> fine de-pixelation of the NEW image. Same idea as transition_mosaic_full but skips the coarsest 8x4 stage.
]]]
attr[segvga:2f9f]: type = code; name = transition_mosaic_fine; comment = [[[
    Effect 0x28: fine-only mosaic with palette swap.
    Three passes of the 2x2 helper loc_segvga_02fc1 on the OLD image, palette_flush, then one more pass on the NEW image. Subtle dither shimmer that masks the palette flip.
]]]
attr[segvga:2fb7]: type = [u16; 5]; name = zoom_tile_offsets; comment = [[[
    4-entry 2x2 sub-pixel offset table for shimmer animation (sentinel: ffff).
    Entries: 0000, 0141, 0001, 0140 — adjacent pixels in a 2x2 block.
]]]
attr[segvga:30f0]: type = code; name = transition_noop_30f0; comment = [[[
    Effect 0x1e: no-op (retf).
    The two bytes 30f0..30f1 also serve as a base address: transition_scripted_sequence reads its script via word ptr [030f0 + bx], so 030f2 is the first script entry.
]]]
attr[segvga:30f1]: type = code; name = transition_noop_30f1; comment = Effect 0x1c: no-op (retf).
attr[segvga:3121]: comment = 4800 words = 30 lines at 320x200
attr[segvga:3130]: type = code; name = transition_vertical_fold; comment = [[[
    Effect 0x04: vertical center-fold transition (the LOOK AT MIRROR reveal).
    Snapshots the visible screen into fb2 (loc_02596), then runs 17 steps from the table at segvga:030f2 (indexed by cl; each step word packs al = rows copied per band, ah = source rows skipped per band).
    Each non-midpoint step calls the fold kernel loc_0316d, which compresses the source image vertically toward the centre row by the ratio al/(al+ah).
    First half (cl 0x11..0x0a): ah grows, squishing the OLD image (fb2) to a thin band at the centre. Step 9 (loc_0311a) clears the screen, switches the source to fb1, and uploads the new palette. Second half (cl 8..1): ah shrinks, expanding the NEW image (fb1) back out from the centre.
    Direction from sign of dl: cx=0x0101 forward (cl 1->0x10), 0xff11 reverse (cl 0x11->1).
]]]
attr[segvga:316d]: name = transition_fold_kernel; comment = [[[
    One frame of the transition_vertical_fold effect.
    di/si walk the top half upward from the centre row 75 (offset 0x5dc0 + fb_base_ofs); bp/bx walk the bottom half downward, so both halves fold toward the centre line together.
    For each of al double-rows it rep-movsw copies a row pair source->dest; the gap loop loc_031b3 then skips ah source rows (sub si / add bx) WITHOUT advancing dest, compressing the source vertically by al/(al+ah).
    Rows outside the compressed band are blacked out by loc_031ce, bounded by data_03118 (the previous frame fold extent).
    cl==9 -> loc_0311a instead clears 0x12c0 words from data_03118, switches ds to fb1, and calls palette_flush.
]]]
attr[segvga:3176]: comment = 75 * 320
attr[segvga:31e6]: type = [ofs16(segvga); 13]; name = blit_mode_dispatch_table
attr[segvga:3200]: name = vga_effect_dispatch; comment = [[[
    Dispatch to one of 13 visual effects via blit_mode_dispatch_table.
    Saves SI/DS/ES for use by effect functions. AX selects effect:
    mask to even, reduce mod 26 → index 0-24 (step 2) into table.
]]]
attr[segvga:321e]: ofs_seg = segvga; targets = segvga:0c04, segvga:276c, segvga:3223, segvga:3382, segvga:33ca, segvga:3429, segvga:3486, segvga:3500, segvga:3581, segvga:3602, segvga:3841, segvga:38d8, segvga:39bb
attr[segvga:3223]: type = code; name = panel_anim_play_all; comment = [[[
    Play all 17 panel animation frames in one blocking call.
    Restores saved DS/ES, copies backing rect, then loops CL 17→0
    calling panel_anim_frame + vsync each step, then restores rect.
]]]
attr[segvga:3280]: name = panel_solid_fill; comment = [[[
    Fill panel rect (col=92, row=159, 136x41) with solid color pattern.
    Called as special case when frame index == 9.
]]]
attr[segvga:32c1]: name = panel_anim_frame; comment = [[[
    Draw one frame of the panel animation (hardcoded rect col=92, row=159, 136x41).
    CX = frame index (0-17); AX = frame data from 030f0 table.
    CL=9 special-cases to a full solid fill (loc_03280).
]]]
attr[segvga:3382]: type = code; name = panel_anim_play_step; comment = [[[
    Play one panel animation frame (caller-stepped).
    CX = current frame index; on CX=1 also restores the rect via vga_copy_rect.
]]]
attr[segvga:33ca]: type = code; name = blit_scroll_rect_down; comment = [[[
    Scroll a rect downward: copies 2 rows from near-bottom, then full vga_copy_rect.
    SI = ptr to rect {x1,y1,x2,y2}. Computes two FB offsets: src at (x1,y2-2), dst at (x1,y2).
]]]
attr[segvga:3429]: type = code; name = blit_scroll_rect_up; comment = [[[
    Scroll a rect upward within the framebuffer by copying rows from 6 rows below.
    SI = ptr to rect {x1,y1,x2,y2}. Copies in blocks of 6 rows (rep movsw from [di+780h]),
    then covers the last 6 rows from the same source.
]]]
attr[segvga:3486]: type = code; name = blit_mode_noop_3486
attr[segvga:3487]: type = [u8; 117]; name = wave_displacement_tbl; comment = [[[
    Per-row signed horizontal offsets for water ripple effect (sentinel: 80h).
    Values trace a sine curve: 1..5..0..-5 for realistic wave displacement.
]]]
attr[segvga:3500]: type = code; name = blit_water_ripple; comment = [[[
    Animate water ripple: cycle palette (palette_cycle_water) then apply
    per-row horizontal shift from wave_displacement_tbl, advancing by one
    row per call via data_034fc counter.
]]]
attr[segvga:356f]: name = fb_row_copy_shifted; comment = [[[
    Copy DX words from ES:DI to ES:DI+sign_ext(AL), then advance DI by 320.
    Used to apply per-row horizontal displacement for water ripple.
]]]
attr[segvga:3581]: type = code; name = blit_zoom_shimmer; comment = [[[
    Animate 2x-scaled shimmer: cycle through 4 sub-pixel offsets from
    zoom_tile_offsets, calling fb_blit_2x_scaled per frame, timer-gated.
]]]
attr[segvga:35c8]: name = fb_blit_2x_scaled; comment = [[[
    Blit DX-wide, BX-tall block from ES:DI+AX to ES:DI at 2x nearest-neighbour scale.
    Reads every other source byte, writes each pixel doubled horizontally
    and vertically (writes to current row and row+320).
]]]
attr[segvga:3602]: type = code; name = xor_bracket_zoom_to_panel; comment = [[[
    The troop-contact popup's open flourish (vga_effect_dispatch al=2): a 20x20
    XOR box stepping from the troop icon (ds:si, x clamped to [0,300]) to the
    panel centre, then the corner brackets expanding out to the panel rect
    ([di] +0..+7, staged by xor_bracket_anim_setup). Each phase runs 2 passes x
    8 frames with one present interval per frame: the XOR draws accumulate over
    the first pass and the identical second pass erases them. Every bracket
    drawn is latched in 035fa..03600 for the close to shrink back from.
]]]
attr[segvga:36b0]: name = xor_bracket_anim_setup; comment = [[[
    Stage the bracket zoom from the panel rect ([di] +0..+7) and the target
    point (035f2/035f4): the origin of a 20x20 box centred on the panel
    (035f6/035f8), the per-frame bracket expand step (half the panel extent
    less 20, /8 - 035ee/035f0) and the per-frame trail step from the target to
    that centre (/8, signed - 035ea/035ec).
]]]
attr[segvga:3724]: name = vga_xor_rect_outline; comment = [[[Draw a rectangle outline by XORing with 0x0F (toggles lower palette nibble; drawing twice erases). DX=x1, SI=width, BX=y1, CX=height. Coordinates clamped to x:[4,316], y:[4,148] — staying clear of the bottom UI panel.]]]
attr[segvga:372d]: name = vga_xor_box_20; comment = [[[
    Draw a 20x20 XOR rect outline at (DX, BX). Wrapper around
    vga_xor_rect_outline_inner with fixed cx=si=20.
]]]
attr[segvga:3733]: name = vga_xor_rect_outline_inner; comment = Convert (DX=x1, SI=width, BX=y1, CX=height) to absolute corners, clamp, then XOR-draw top row, right side, bottom row, left side in order.
attr[segvga:37b1]: name = vga_xor_corner_brackets; comment = [[[
    XOR-draw corner brackets at (DX=x, BX=y, CX=width, SI=height), colour 0x0f:
    a 10-pixel horizontal edge segment and a 9-pixel vertical spine at each
    corner. Framebuffer offsets are not clamped.
]]]
attr[segvga:3841]: type = code; name = xor_bracket_zoom_from_panel; comment = [[[
    The troop-contact popup's close flourish (vga_effect_dispatch al=4), the
    open played backwards from the state xor_bracket_zoom_to_panel staged: the
    brackets shrink from the last latched shape (035fa..03600) back towards a
    centred 20x20, then the box trail steps from the panel centre back to the
    troop icon. 2 passes x 8 frames per phase, the second pass XOR-erasing the
    first.
]]]
attr[segvga:38d8]: type = code; name = xor_rect_outline_advance; comment = [[[
    Panel outline scale-in (vga_effect_dispatch al=6): grow an XOR rectangle
    outline from the source point (ds:si, the clicked icon/marker less 10, +8)
    to the panel rect (es:di record +0..+7) over 15 frames. Computes the
    per-frame top-left step (|panel - start| / 16, signed) and size step (panel
    extent / 16), stores the panel corners for the reverse, then falls into
    xor_rect_outline_animate.
]]]
attr[segvga:3970]: name = xor_rect_outline_animate; comment = [[[
    The 15-frame XOR outline animation loop shared by the scale-in/out: each
    frame advances the rect by the per-frame deltas, XOR-draws the outline
    (vga_xor_rect_outline_inner), waits one present interval (loc_02572), then
    XOR-draws again to erase.
]]]
attr[segvga:39bb]: type = code; name = xor_rect_outline_reverse; comment = [[[
    Panel outline scale-out (vga_effect_dispatch al=8): reload the panel corners
    stored by xor_rect_outline_advance, negate all four per-frame steps, and run
    xor_rect_outline_animate to shrink the outline back to the source point.
    The open path suppresses this via data_046d8 when a selection replaces the
    panel.
]]]
attr[segvga:39e9]: name = vga_draw_noisy_line; comment = [[[
    Draw a horizontal line of CX pixels with a color ramp and LFSR-dithered noise.
    BX=row, DX=col: start position (via calc_fb_offset).
    AX=initial ramp accumulator (DH = base color index).
    DI=ramp step added to DX each pixel (fixed-point; DH is the integer part).
    BP=LFSR seed; SI=LFSR feedback polynomial.
    Each pixel = DH + ((BP & 3) - 1), giving ±1-2 noise around the ramp.
]]]
attr[segvga:3a06]: type = [ofs16(segvga); 7]; name = zoom_kernel_table; comment = Seven zoom kernel entry points indexed by BP (1-7, doubled before use as byte offset from 3a04h).
attr[segvga:3a14]: name = vga_zoom_screen; comment = [[[
    Zoom in on a point in the current framebuffer and write the scaled result from fb_base_ofs.
    BX=row, DX=col selects the source point (via calc_fb_offset).
    BP=scale selector (1-7): 1=8/7, 2=4/3, 3=3/2, 4=2x, 5=3x, 6=4x, 7=8x.
    All kernels output 320x152 pixels.
]]]
attr[segvga:3a20]: targets = segvga:3a25, segvga:3a69, segvga:3a9d, segvga:3ad9, segvga:3af6, segvga:3b46, segvga:3b6d
attr[segvga:3a25]: type = code; name = zoom_kernel_8_7; comment = Reads 7 source bytes, writes 8 dest bytes per group (8/7 horizontal scale). Rows: BX=19.
attr[segvga:3a69]: type = code; name = zoom_kernel_4_3; comment = Reads 3 source bytes, writes 4 dest bytes per group (4/3 horizontal scale). Rows: BX=38.
attr[segvga:3a9d]: type = code; name = zoom_kernel_3_2; comment = Reads 2 source bytes, writes 3 dest bytes per group (3/2 horizontal scale). Rows: BX=50.
attr[segvga:3ad9]: type = code; name = zoom_kernel_2x; comment = Doubles each pixel horizontally (stosw) and vertically (writes to [di+140h]). Rows: BX=76.
attr[segvga:3af6]: type = code; name = zoom_kernel_3x; comment = Triples each pixel: writes 3 bytes per pixel across 3 rows via [di+13dh] offsets. Rows: BX=50.
attr[segvga:3b46]: type = code; name = zoom_kernel_4x; comment = 4x zoom: each source byte written as 4 pixels wide x 4 rows. Reads 80 pixels/row (skips 240 to maintain 320-byte stride), 38 source rows → 320x152 output.
attr[segvga:3b6d]: type = code; name = zoom_kernel_8x; comment = 8x zoom: each source byte written as 8 pixels wide x 8 rows. Reads 40 pixels/row (skips 280), 19 source rows → 320x152 output.

end
