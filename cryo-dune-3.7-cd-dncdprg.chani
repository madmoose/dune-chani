attr[seg000:008f]: ofs_seg = seg000
attr[seg000:0098]: type = code; name = adjust_sub_resource_pointers; comment = [[[Relocate in place the sub-resource offset table at the head of a freshly loaded resource buffer (ES:DI). The first word holds the table length in bytes; cx = word>>1 is the entry count, and bx=di captures the buffer base. Each entry is a buffer-relative near offset; adding the base turns it into a usable near pointer into the same segment. Called after loading DIALOGUE (seg000:0123) and CONDIT (seg000:0134).]]]
