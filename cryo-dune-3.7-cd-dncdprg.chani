attr[seg001:0044]: type = u16; name = for_condit_troop_troop_occupation_dependent_C_ds_44; comment = [[[
    Usage depends on troop occupation:
    * Go & search for equipment: target location;
    * Espionage: number of Harkonnen troops seen;
    * Attacking: number of Harkonnen killed.
]]]
attr[seg001:0046]: type = u16; name = for_condit_troop_troop_occupation_dependent_E_ds_46; comment = [[[
    Usage depends on troop occupation:
    * Spice mining: amount of spice extracted at the current location since the beginning of this mining occupation;
    * Spice prospecting: percentage of the area covered;
    * Go & search for equipment: when going back, requestd equipment found at target location, if any:
    * Espionage: information derived from Harkonnen troop armament and skill;
    * Attacking: number of Fremen killed.
]]]
attr[seg001:0048]: type = u16; name = for_condit_ds_48; comment = [[[
    The troop current spice production rate, staged by
    troop_prepare_troop_data_for_condit from troop_update_harvest_rate (the same
    value the mining callback harvests that period). The info panel shows it as
    Current N kgs/h; ds:4a holds the running average beside it.
]]]
attr[seg001:004a]: type = u16; name = for_condit_ds_4a; comment = Used at least for the average spice mining production level.
attr[seg001:004c]: type = u8; name = related_to_contacting_troops_ds_4c; comment = [[[
    0xff while the contacted troop answers from outside
    location_visibility_distance (set by map_open_troop_contact_dialogue), so the
    contact dialogue record conditions pick its out-of-contact lines. Cleared by
    map_close_troop_contact_popup, which also skips marking the contact on the
    troop when it was set.
]]]
attr[seg001:004d]: type = u8; name = for_condit_location_appearance_ds_4d
attr[seg001:004e]: type = u16; name = for_condit_location_location_area_and_name_ds_4e
