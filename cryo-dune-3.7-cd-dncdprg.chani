attr[seg001:2244]: type = u16; comment = [[[
    The troop-contact subtitle layout descriptor: 153x63, its x/y origin written
    per open by map_draw_troop_contact_popup (the popup panel origin + (0x49,3)).
    subtitle_setup_layout picks it for every line presented while the full-map
    view owns the screen (data_046eb != 0, seg000:8cd8).
]]]
