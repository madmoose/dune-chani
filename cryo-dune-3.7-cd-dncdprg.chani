attr[seg000:9123]: type = code; name = character_id_to_sprite; fn = in id: u8 @al, out sprite_pair: u16 @ax; comment = [[[
    = character_id_to_sprite. Map a person id (al) to a PERS.HSQ sprite-pair
    index (returned in ax, ah=0) and, as a side effect, set data_047d0 = the
    talking-head idle expression the face animator reads (loc_0994f / loc_09a7b).
    
    Four cases:
      - id < 0x0d (named characters): return id unchanged; data_047d0 = 0, i.e.
        the random idle path (loc_0994f picks animations {0..3}).
      - id == 0x0d (the SMUG smuggler head, char_to_sprite_smug): data_047d0 =
        (command_menu_x >> 1) + 1, read from the active verb-list header byte
        [current_location_ptr][0] (the menu x pixel origin). The reason the idle
        facing is keyed to the menu x-origin is not yet understood.
      - id 0x0e..0x10: fold in walk/facing animation state (char_to_sprite_walk_
        facing, via data_04756 / data_04758 / data_0476c and the game_phase 0xc8 gate).
      - id >= 0x11, incl. the player 0x2d (char_to_sprite_player): al is forced to
        0x2d (PAUL) and data_047d0 is derived from the in-game clock (game_time),
        so Paul visibly ages across the game.
]]]
attr[seg000:912f]: name = char_to_sprite_smug; comment = [[[
    = id == 0x0d (the SMUG smuggler head): derive the idle expression from the
    active verb-menu position. di = current_location_ptr; ah = [di] = the command-
    list header byte 0 = the menu x pixel origin (= command_menu_x, see
    set_command_menu_origin seg000:2e98). data_047d0 = (menu_x >> 1) + 1.
    Why the smuggler idle facing is keyed to the menu x-origin is not yet
    understood.
]]]
attr[seg000:913b]: name = char_to_sprite_walk_facing; comment = [[[
    = id 0x0e..0x10: fold in the walk/facing animation state. si = data_04756;
    id 0x0e uses it directly, otherwise (unless game_phase >= 0xc8) index
    data_04758 by data_0476c. loc_09155 divides the facing byte by 3 and folds
    it into the sprite index.
]]]
attr[seg000:914a]: let = walk_idx: u8 @al
attr[seg000:9171]: comment = [[[
    = loc_09171 (from loc_0917a): inc ah — the final +1 of the player
    expression, then fall through to the data_047d0 store.
]]]
attr[seg000:9173]: name = char_to_sprite_store_expr; comment = [[[
    = store the computed idle expression: data_047d0 = ah, then ax = al
    (xor ah,ah) so the sprite-pair index is returned in ax.
]]]
attr[seg000:917a]: name = char_to_sprite_player; comment = [[[
    = the player branch (id >= 0x11). Derive the talking-head idle expression
    from the in-game clock and force the sprite to PAUL (0x2d).
    
      ah = min((game_time*4) >> 8, 8)   ; == min(game_time >> 6, 8)
      ah = ah*2 + (desert_walk_counter >= 0x10 ? 1 : 0) + 1   ; via loc_09188 / cmc;adc / inc ah
      al = 0x2d
      data_047d0 = ah
    
    Higher game_time selects the higher (later, blue-eyed) idle animations;
    at game start game_time is small so data_047d0 == 1 -> the youngest idle
    animation 0 (loc_0994f / loc_09a7b use animation data_047d0 - 1).
]]]
attr[seg000:9188]: name = char_to_sprite_player_clamp; comment = [[[
    = clamp the game_time-derived expression: ah = min(ah, 8) (9181..9186),
    then ah *= 2. cmc;adc ah,0 (918a..9190) adds 1 when desert_walk_counter
    >= 0x10; inc ah (loc_09171) adds the final +1.
]]]
attr[seg000:9197]: type = code; name = setup_lip_sync_data_from_current
