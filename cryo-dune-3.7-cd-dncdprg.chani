attr[seg000:7f27]: name = compute_location_available_equipment; ofs_seg = seg001; comment = [[[
    Compute the location (di) per-type available equipment into the global
    7-byte buffer at 46fe (location_available_equipment), then fall through
    into location_iterate_on_troops_in_location with bx = that buffer.
    Slot 1 of the buffer is orni_count (46ff), read by
    build_room_command_records to grey TAKE AN ORNITHOPTER while < 1.
]]]
attr[seg000:7f2a]: type = code; name = location_iterate_on_troops_in_location; fn = in location: *Location @di; comment = [[[
    di = *Location, bx = destination 7-byte buffer. Copy the location's
    harvesters..bulbs equipment row into [bx], then walk the location troop
    list (head location->troop_id, next troop->next_troop_id) and for each
    troop subtract its held equipment: one dest slot per set bit of
    troop->equipment, MSB first (harvesters, ornithopters, krys_knives,
    laser_guns, weirding_modules, atomics, bulbs), each decrement clamped
    at 0. Leaves [bx] = equipment present at the location but not yet held
    by its troops.
]]]
