attr[seg001:11e9]: type = u16
attr[seg001:11eb]: type = u16; name = string_subst_id_table; comment = [[[
    String-id table for the inline name placeholders 0x80..0x8f in dialogue/subtitle text.
    format_interpolated_string (seg000:8970) maps placeholder 0x8N to entry[N]: ax = [N*2 + 11ebh].
    Each entry is a COMMAND/PHRASE string id passed to get_phrase_or_command_string_si (seg000:cf70) and expanded in place.
    entry[0] (placeholder 0x80) is unused: 0x80 reads an inline 16-bit id from the text instead.
    Some entries are overwritten at runtime with the active location name; entries 1-2 also alias command_menu_x/command_menu_y.
    Default ids resolve to the COMMAND1 strings noted per entry.
    entry[0]: default id 1 = COMMAND "Arrakeen" (unused).
]]]
attr[seg001:11ed]: type = u16; name = command_menu_x; comment = [[[
    Verb-menu draw origin x. = command_list header[0]. Set by set_command_menu_origin (seg000:2e98).
    string_subst_id_table[1]: placeholder 0x81 default id 1 = COMMAND "Arrakeen".
]]]
attr[seg001:11ef]: type = u16; name = command_menu_y; comment = [[[
    Verb-menu draw origin y. = command_list header[1] + 0ch. Set by set_command_menu_origin (seg000:2e98).
    string_subst_id_table[2]: placeholder 0x82 default id 2 = COMMAND "Carthag".
]]]
attr[seg001:11f1]: type = u16; name = subst_id_03; comment = string_subst_id_table[3]: placeholder 0x83 default id 3 = COMMAND "Tuono".
