attr[seg001:2786]: type = u16; name = troop_icon_draw_order_func; comment = [[[
    Pointer to the draw-order pick troop_icons_update_dirty_rect calls at
    seg000:c766 for each icon it draws (si = the collected icon-ptr list,
    cx = its length; returns bx = the chosen slot, SF set when done):
    troop_icons_pick_next_fifo (0xc827, the default — insertion order) or
    troop_icons_pick_next_by_depth (0xc835, the full map view — back-to-front
    layering). callback_transition_05a56 installs 0xc835;
    reset_room_scene_state restores 0xc827.
]]]
attr[seg001:2788]: type = u8; name = game_suspend_count; comment = [[[
    Nesting suspend counter for the live game (static init 1 = suspended during
    load/intro). While nonzero the PIT callback skips advancing game_time
    (seg000:ef84) and the idle-event trigger is suppressed (seg000:1b12 ->
    loc_02b2a). suspend_game_clock / resume_game_clock inc/dec it; reset_game_suspend
    zeroes it; pause_if_p_key_pressed bumps it to 1 around the pause window.
]]]
