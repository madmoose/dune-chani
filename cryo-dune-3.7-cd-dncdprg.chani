attr[seg000:851f]: name = troop_link_into_location_and_assign_position; comment = [[[
    Append the troop to its destination location: an empty chain takes it as
    the head at position 1 (9 for a Harkonnen troop, the mirrored slot bank);
    otherwise link it after the chain tail and give it the first free position
    from a 30-slot occupancy bitmap (Harkonnen troops scan from slot 9).
]]]
attr[seg000:858c]: name = troop_unlink_from_location_chain; comment = [[[
    Unlink the troop from its location troop chain (predecessor takes its
    next id; the chain head case at loc_085c2 moves the head) and clear its
    next id. Occupation bit 6 (still moving) skips the chain search.
]]]
attr[seg000:85cc]: name = troop_location_085cc; comment = [[[
    After the position assign: a non-Harkonnen troop that landed in the
    Harkonnen slot bank (position > 8) re-rolls - unlink it, remove the first
    captured (occupation bit 5) Harkonnen troop of the chain from play
    (troop_remove_from_play), and assign a position again.
]]]
attr[seg000:8604]: name = troop_travel_substep_delta; fn = in troop: *Troop @si, out dlng: u16 @dx, out dlat: u16 @bx; comment = [[[
    One travel sub-step toward the destination location (troop->offset_of_
    location): dlng/dlat to add to the gps position, (0, 0) = arrived.
    The longitude gap is scaled to map cells by lng_units_per_cell_table[|lat|].
    Dominant-axis logic: arrival when the dominant distance (cells, or |dlat|
    rows) is below 7. Longitude-dominant: step one cell toward the target
    (the sub-cell remainder is snapped whole), latitude +-1 only on a set
    rolling rand bit; latitude-dominant: step +-1 row, longitude one cell only
    on a set rand bit (a sub-cell longitude gap is snapped whole).
]]]
attr[seg000:8685]: name = map_select_troop; comment = [[[
    (Re)build the selected-troop UI: remove the old highlight ring, tear down
    the contact dialogue popup (map_close_troop_contact_popup) and the open
    popups (map_close_location_troop_popup / map_close_troop_info_popup /
    loc_058fa), then for a valid data_01954 latch it in data_01955, spawn the
    highlight ring (map_focus_troop_icon), open the contact verb menu
    (map_open_troop_contact_menu) and the troop dialogue (troop_07c02).
]]]
attr[seg000:86b9]: name = map_contact_troop_at_current_location; comment = [[[
    The GIVE ORDERS TO TROOP path (location_visibility_distance < 2): select the
    troop at the head of the current location' chain ([di+9]), recentre the map on
    the player (set_zoomed_globe_pos_from_map_position + the installed main-view
    redraw) and rebuild the contact UI (map_select_troop).
]]]
attr[seg000:86c6]: targets = seg000:4377, seg000:49a0
attr[seg000:86cc]: type = code; name = menu_callback_choice_map_main_contact_fremen_troops; comment = [[[
    The map main menu' contact slot: CONTACT FREMEN TROOPS over the whole planet,
    or GIVE ORDERS TO TROOP while location_visibility_distance < 2
    (map_setup_main_menu picks the wording, both dispatch here). Needs
    number_of_rallied_troops != 0. Reads data_01954/data_01955 as one word: a live
    selection cycles on (menu_callback_choice_map_troop_contact_next_troop), else
    the last contacted troop (data_01955) is resumed as long as it still has an
    icon on the map, else the cycle starts from id 0.
]]]
attr[seg000:86fa]: type = code; name = menu_callback_choice_map_troop_contact_next_troop; ofs_seg = seg001; comment = [[[
    The NEXT TROOP verb: scan troop_icons for the rallied troop (occupation < 0x80)
    whose id has the smallest non-zero unsigned delta from data_01954 - i.e. the
    next id above the selection, wrapping past the end of the troop table - then
    fall into map_click_troop_icon with that icon.
]]]
attr[seg000:872c]: name = map_click_troop_icon; comment = [[[
    An LMB click on a troop icon (si = the icon): while
    location_visibility_distance < 2 a troop at the current location is handled
    in the room instead; a click on the already-selected troop (data_01954)
    goes straight to the troop dialogue (troop_07c02); otherwise select it and
    rebuild the contact UI (map_select_troop).
]]]
attr[seg000:8751]: type = code; name = map_troop_contact_cleanup; comment = [[[
    The cleanup func every troop-contact menu is staged with (bx at seg000:783e):
    for a live selection (data_01954) remove the highlight ring
    (map_remove_focused_troop_icon), clear data_01954 (data_01955 keeps the id so
    the contact verb can resume the troop) and tear down the dialogue popup
    (map_close_troop_contact_popup).
]]]
attr[seg000:8763]: type = code; name = menu_callback_choice_multiple_no_more_orders
attr[seg000:8770]: type = code; name = menu_callback_choice_map_troop_contact_no_more_orders
attr[seg000:878c]: name = map_setup_main_menu; comment = [[[
    Configure and open the map main verb menu (menu_map_main): TAKE AN
    ORNITHOPTER (id 0xa7) greyed (id bit 0x4000) unless the current location has
    an ornithopter; SEE SPICE DENSITY greyed and FIND PROSPECTORS hidden (id 0)
    until game_phase >= 5; the contact slot is CONTACT FREMEN TROOPS (0x62,
    greyed while no troop icons are on the map) or, while
    location_visibility_distance < 2, GIVE ORDERS TO TROOP (0x93, greyed unless
    the current location has a troop). Pushes the screen element with a no-op
    cleanup, then reopens ONMAP.
]]]
