attr[seg001:00c5]: type = u8; name = person_marker_base; comment = [[[
    Random base offset for arranging people standing in a room. Set
    to rand() at room setup (seg000:4fc6), reset to 0 on scene change
    (seg000:02a2). sal_assign_position_marker reads (low nibble) as
    the base in preferred slot = (person_id + base) % count.
]]]
attr[seg001:00c6]: type = u8; name = book_flags; comment = [[[
    Book-screen flags, doubling as the subtitle-suppress gate (any nonzero
    value makes present_first_matching_dialogue_line skip show_voice_subtitle,
    the loc_0a034 gate; run_game_phase_triggers sets bit 0x80 around the
    phase-trigger walk). Book bits: 1 = book screen active, 2 = showing the
    cover, 4 = credits rolling past the last page.
]]]
