attr[seg000:5a9a]: type = code; name = ui_main_view_map_interface; comment = [[[
    Compose the full DUNE MAP view into fb1: restore/clip rects = the map rect
    (loc_05b8d), force data_046eb = 0x80 around map_draw_zoomed_globe (the
    interpolated full-planet map, vga_draw_map_zoomed), draw the vegetation marks
    + location markers (map_build_and_draw_location_markers, ONMAP base 0x7a) and
    the player position sprite (map_draw_player_position_sprite), snapshot fb1 to
    fb2, reset the troop icon list and spawn the troop icons
    (map_spawn_troop_icons), present the map window over the snapshot
    (troop_icons_update_dirty_rect), configure + push the map main menu
    (map_setup_main_menu), then with bit 0x40 re-enter the spice-density overlay
    (loc_05406), install the map mouse handlers (mouse_handlers_01a9e) and the map
    nav rect.
]]]
