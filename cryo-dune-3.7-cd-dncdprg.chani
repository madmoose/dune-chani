attr[seg001:dbcb]: type = u8; name = _byte_2D07B_current_song_index; comment = [[[
    Index of the currently loaded music song (0 = none).
    Written by play_music at seg000:ada5 to mirror the song-id argument (al).
    Read by play_VIRGIN_HNM and similar HNM playback loops to gate per-frame midi_reset calls.
]]]
attr[seg001:dbcd]: type = u8; name = _byte_2D07D_midi_status; comment = [[[
    Midi driver status byte (mirror of the driver-side status).
    Bit 7 = song is playing.
    Set to the al return of driver function calls: MIDI_Open (play_music) sets it to 0x80 (playing); MIDI_Reset sets it to 0 (stopped). midi_wait_until at seg000:de0c gates on the sign bit: when non-negative (high bit clear) the wait short-circuits and returns immediately.
]]]
attr[seg001:dbce]: type = u16; name = _word_2D07E_midi_measure; comment = [[[
    Midi current measure number (1-based).
    Returned in bx by the driver tick handler (MIDI_Tick) and saved here every tick.
    Incremented every 96 ticks. Used by midi_wait_until to compute song position: (measure << 4) | (((0x60 - ticks_remaining) / 6) & 0xf).
]]]
attr[seg001:dbd0]: type = u16; name = _word_2D080_midi_ticks_remaining; comment = [[[
    Midi ticks remaining in the current measure (counts from 0x60 down to 1).
    Returned in cx by the driver tick handler (MIDI_Tick) and saved here every tick.
    Used together with _word_2D07E_midi_measure to compute the position in midi_wait_until.
]]]
