attr[seg000:8403]: type = code; name = callback_troop_08403; comment = [[[
    Arrival notification for each hired resident troop: spice miners
    (occupation 1) stop working, captured troops and those already at 6 are
    left alone, everyone else switches to occupation 6 (defending).
]]]
attr[seg000:841f]: comment = [[[
    The turn-around arrival (occupation low bits 11b at a hostile location):
    away from home ([si+0xc]) the troop returns its borrowed equipment word
    [si+0xe] (slot index in the low byte, the troop equipment bit in the high
    byte; handed back only while the location has a free unit) and re-targets
    home; at home it clears occupation bits 0-1 and settles (loc_083bc).
]]]
attr[seg000:8454]: type = code
attr[seg000:8461]: name = troop_refresh_icon; comment = [[[
    Refresh the troop map icon after its occupation changed: remove the old icon
    (troop_icon_remove) and respawn it through troop_0846c - the sprite and anim
    script are picked from the occupation. A stationed troop needs a visible
    location marker; a moving one (occupation bit 6) always respawns.
]]]
